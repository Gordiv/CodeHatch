<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Meta name="ExplicitAutoJoints">true</Meta>
	<External>null</External>
	<External>nil</External>
	<Item class="Script" referent="RBX0B2F4DF07C3C4E19A9C49B3060FEA1CC">
		<Properties>
			<string name="Name">DiscordCodes</string>
			<bool name="Disabled">false</bool>
			<ProtectedString name="Source"><![CDATA[--!nonstrict
--[[
	DiscordCodes  (Script, ServerScriptService)

	Starts the code system and the live content from Discord: creates the remotes, gives players their windows and
	starts the modules. Inside this script there are: the ModuleScripts "Core" (codes and rewards), "Report" (tells the
	bot the file version and what the game has) and "Live" (events, eggs, gifts, announcements),
	the LocalScripts "DiscordCodesClient" and "DiscordLiveClient", the ⚙️ Manager for the game's owner ("Manager",
	"Control" which makes its changes in the game by itself, and the ScreenGui "DiscordManager", given only to the
	owner) and the "Settings" folder (the default settings;
	change yours in the ModuleScript ServerScriptService.DiscordSettings, which an update never touches).
	The DiscordCodes.rbxmx file inserts all of it automatically.

	After a bot update that changes this file, /setup-roblox on Discord says so: move this script to ServerStorage (a
	safe backup, scripts there do not run), insert the new DiscordCodes.rbxmx from the bot's "scripts" folder the same
	way as the first time, test with Play, then publish the game. Keep your own things OUTSIDE this script (your own
	scripts, the window template DiscordCodesGui in StarterGui) and an update never touches them.
	The game also tells the bot what it has (value names in player data, egg spots and models, multipliers used by your
	code), so /setup-roblox can offer the right names.
]]

-- Version of this file. Every game server reports it to the bot (/setup-roblox shows whether the game has the newest file).
-- Set by tools/build_roblox_kit.py, do not change it.
local KIT_VERSION = 83

local Players = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")
local StarterGui = game:GetService("StarterGui")
local StarterPlayer = game:GetService("StarterPlayer")

local Core = require(script:WaitForChild("Core"))
local Report = require(script:WaitForChild("Report"))
local Live = require(script:WaitForChild("Live"))
local Control = require(script:WaitForChild("Control"))
local Manager = require(script:WaitForChild("Manager"))
local settings = script:FindFirstChild("Settings")
local templates = { script:WaitForChild("DiscordCodesClient"), script:WaitForChild("DiscordLiveClient") }

-- The owner's settings live in the ModuleScript ServerScriptService.DiscordSettings (DiscordSettings.rbxmx), outside
-- this script, so an update of this file never resets them. They are copied into the Settings folder here, before the
-- players' windows get a copy of it; everything else reads the folder.
local VALUE_TYPES = { BoolValue = "boolean", StringValue = "string", IntValue = "number" }
-- Places on the screen: a name, optionally moved by pixels ("BottomRight", "Left 0,-80")
local PLACE_SETTINGS = { ButtonPosition = true, ManagerPosition = true, EventPosition = true, AnnouncementPosition = true,
	NotificationPosition = true }
local PLACES = { left = true, right = true, top = true, bottom = true, center = true, topleft = true, topright = true,
	bottomleft = true, bottomright = true }
local function isPlace(text)
	local name, x, y = string.match(text, "^%s*(%a+)%s*([%+%-]?%d*)%s*,?%s*([%+%-]?%d*)%s*$")
	return name ~= nil and PLACES[string.lower(name)] == true and math.abs(tonumber(x) or 0) <= 2000
		and math.abs(tonumber(y) or 0) <= 2000
end
local function applyOwnSettings()
	local module = ServerScriptService:FindFirstChild("DiscordSettings")
	if not module or not settings then
		return
	end
	if not module:IsA("ModuleScript") then
		warn("[DiscordCodes] ServerScriptService.DiscordSettings must be a ModuleScript: insert DiscordSettings.rbxmx again.")
		return
	end
	local ok, values = pcall(require, module)
	if not ok or type(values) ~= "table" then
		warn("[DiscordCodes] DiscordSettings could not be read (" .. tostring(values) .. "): the default settings are used.")
		return
	end
	local used = {}
	for name, value in pairs(values) do
		local target = settings:FindFirstChild(tostring(name))
		local wanted = target and VALUE_TYPES[target.ClassName]
		if not wanted then
			warn("[DiscordCodes] DiscordSettings: there is no setting named " .. tostring(name) .. " (check the spelling).")
		elseif type(value) ~= wanted or (wanted == "number" and value ~= math.floor(value)) then
			warn("[DiscordCodes] DiscordSettings: " .. tostring(name) .. " must be " .. (wanted == "number" and "a whole number"
				or wanted == "boolean" and "true or false" or "text in quotes") .. ", the default is used.")
		elseif PLACE_SETTINGS[name] and not isPlace(value) then
			warn("[DiscordCodes] DiscordSettings: " .. tostring(name) .. " must be a place like \"Left\", \"BottomRight\" or "
				.. "\"Left 0,-80\" (Left, Right, Top, Bottom, Center, TopLeft, TopRight, BottomLeft, BottomRight), the default is used.")
		elseif name == "EventEffects" and value ~= "full" and value ~= "light" and value ~= "off" then
			warn("[DiscordCodes] DiscordSettings: EventEffects must be \"full\", \"light\" or \"off\", the default is used.")
		else
			target.Value = value
			table.insert(used, tostring(name))
		end
	end
	table.sort(used)
	print("[DiscordCodes] Your settings from DiscordSettings: " .. (#used > 0 and table.concat(used, ", ") or "none"))
end
applyOwnSettings()

local remote = Core.FindRemote("DiscordCodesRedeem", "RemoteFunction")
remote.OnServerInvoke = function(player, codeText)
	return Core.RedeemCode(player, codeText)
end

local function makeClient(template)
	local client = template:Clone()
	if settings then
		settings:Clone().Parent = client
	end
	client.Disabled = false
	return client
end

-- The template window (if the game has it) must not be recreated after every respawn: the client wires it once
local windowTemplate = StarterGui:FindFirstChild("DiscordCodesGui")
if windowTemplate and windowTemplate:IsA("ScreenGui") then
	windowTemplate.ResetOnSpawn = false
end

-- New players get the windows from StarterPlayerScripts
local starterScripts = StarterPlayer:WaitForChild("StarterPlayerScripts")
for _, template in ipairs(templates) do
	if not starterScripts:FindFirstChild(template.Name) then
		makeClient(template).Parent = starterScripts
	end
end

-- Players who joined before this script started (e.g. in Studio) get the windows right away
for _, player in ipairs(Players:GetPlayers()) do
	local playerGui = player:FindFirstChildOfClass("PlayerGui")
	if playerGui then
		for _, template in ipairs(templates) do
			if not playerGui:FindFirstChild(template.Name) then
				makeClient(template).Parent = playerGui
			end
		end
	end
end

print("[DiscordCodes] File version " .. KIT_VERSION)

-- Hints for the most common mistakes after installing or updating (nothing here changes how the codes work)
local copies = 0
for _, sibling in ipairs(script.Parent:GetChildren()) do
	if sibling:IsA("Script") and sibling.Name == script.Name then
		copies = copies + 1
	end
end
if copies > 1 then
	warn(
		"[DiscordCodes] Found "
			.. copies
			.. " DiscordCodes scripts next to each other. Keep only the new one and move the old one to ServerStorage, "
			.. "otherwise the codes run twice."
	)
end
if script.Parent ~= ServerScriptService then
	warn("[DiscordCodes] This script is in " .. script:GetFullName() .. ". Drag it into ServerScriptService.")
end
print(
	"[DiscordCodes] Code window: "
		.. (windowTemplate and "your template (StarterGui.DiscordCodesGui)" or "built-in (no DiscordCodesGui in StarterGui)")
)
Core.Start()
Live.Start()
Report.Start({ version = KIT_VERSION, live = Live })
Control.Start({ core = Core, live = Live, report = Report })
Manager.Start({
	core = Core,
	live = Live,
	control = Control,
	version = KIT_VERSION,
	settings = settings,
	template = script:FindFirstChild("DiscordManager"),
})
]]></ProtectedString>
		</Properties>
		<Item class="ModuleScript" referent="RBXA67AE8F5891A4EEC988D5CAC83BA08EE">
			<Properties>
				<string name="Name">Core</string>
				<ProtectedString name="Source"><![CDATA[--!nonstrict
--[[
	DiscordCodes / Core  (ModuleScript)

	Core of the code system: loads the codes sent by the Discord bot, makes sure each player redeems a code only once
	and gives the rewards. The game's ⚙️ Manager saves its own codes into the same list (Core.ChangeCodes, used by the
	Control module), so codes work also when the bot is off.

	RULE: the script NEVER invents a place for a reward. It only adds rewards where your game already keeps them.
	If it can't find exactly one such place, the player sees a message and the code is NOT used up.

	AUTOMATIC REWARDS (names from the bot; letter case, spaces and underscores don't matter):
	- Currency:       an IntValue/NumberValue named like the currency (e.g. leaderstats.Coins, player.Data.Coins)
	                  or an existing numeric player attribute with that name.
	- EXP:            a value or attribute named EXP, XP or Experience.
	- Permanent item: a BoolValue (set to true) or IntValue/NumberValue (+1) named like the item or "Has<Item>",
	                  or an existing attribute with that name.
	- Timed item:     a value or numeric attribute named "<Item>_ExpiresAt" (an os.time() timestamp),
	                  extended by the reward duration.
	The player's data is searched, skipping Backpack, StarterGear, PlayerGui and PlayerScripts.
	If several places match (e.g. leaderstats.Coins and Data.Coins), the script doesn't guess: it lists them in the server log.
	If an error interrupts giving a reward, every change already made is undone.

	YOUR OWN SAVE SYSTEM (e.g. ProfileStore, data tables)
	No external script can see such data, so add ONE function in your own server script:

		local Core = require(game.ServerScriptService:WaitForChild("DiscordCodes"):WaitForChild("Core"))
		Core.OnReward = function(player, reward)
			-- reward.currency = { name = "Coins", amount = 500 }                                     (may be nil)
			-- reward.exp      = 2000                                                                 (may be nil)
			-- reward.item     = { name = "VIP Pass", is_temporary = true, duration_seconds = 86400 } (may be nil)
			-- reward.refund   = true when this gives BACK the price of an egg that couldn't hatch: add exactly
			--                   that amount, never multiply it (no 2x gamepass, no Live.GetMultiplier)
			-- 1. First check that you can give EVERYTHING. If not, return false (add nothing).
			-- 2. Then add the rewards and return true.
			return true
		end

	true      = rewards given.
	false/nil = nothing was given and the code is NOT used up (the player can try again, a gift keeps waiting). The
	automatic mode is NOT tried: with your own save system it would write into a copy (e.g. leaderstats) that is lost
	on the next join. Return false when the player's data isn't ready yet (e.g. the profile is still loading).
	An error in OnReward = the code is marked as redeemed (so an error halfway through can't be used to get the
	reward over and over) and the server log shows the error.

	ORDER OF REDEEMING: the code is saved as used by this player FIRST, then the reward is given. If the reward can't be
	given (an error in the automatic mode), the code is released again. If the server stops in the very moment between
	the two steps, the player keeps the code used without the reward (never the other way round: a reward twice).

	LIMIT: MaxCurrencyPerCode in ServerScriptService -> DiscordSettings (0 = no limit). A code or a gift from Discord with more currency than this is
	refused (the code is NOT used up) and the server log says so, so a mistake on Discord can't flood your economy.

	PLAYER DATA (privacy): the DataStore "PlayerRedeemedCodes_v1" keeps "<UserId>_<CODE>" for every redeemed code, and
	"DiscordGifts" keeps gifts waiting under "gift_<UserId>_...". When Roblox asks you to delete a player's data (a "Right to
	erasure" request), remove that player's keys from both DataStores (Creator Hub -> your game -> Data Stores).

	Event after a successful redeem: Core.CodeRedeemed:Connect(function(player, code, reward) ... end)

	PAYING WITH YOUR OWN SAVE SYSTEM (eggs from Discord take currency through Core.Spend)
	The automatic mode takes currency from the same values as above. With your own save system add:

		Core.OnSpend = function(player, currencyName, amount)
			-- return true if you took the amount, false if the player doesn't have enough (take nothing then)
			return false
		end

	With OnSpend set, set Core.OnReward too: when a pet can't be given, the price goes back through it (reward.refund),
	into your own save system and not into a copy such as leaderstats.
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local TextService = game:GetService("TextService")

local CONFIG = {
	CodesDataStore = "DiscordCodeSync", -- these three values must match the bot (/setup-roblox -> Game connection)
	CodesEntryKey = "ActiveCodes",
	MessagingTopic = "DiscordCodes",
	RedeemedDataStore = "PlayerRedeemedCodes_v1", -- remembers who already redeemed which code
	PollIntervalSeconds = 60,
	MaxCodeLength = 30, -- the redeemed code is saved as "UserId_CODE" and Roblox keys hold at most 50 characters
	CooldownSeconds = 2,
	ExpNames = { "EXP", "XP", "Experience" },
	IgnoredContainers = { Backpack = true, StarterGear = true, PlayerGui = true, PlayerScripts = true },
}

local Core = { Config = CONFIG, OnReward = nil }

local codeRedeemedEvent = Instance.new("BindableEvent")
Core.CodeRedeemed = codeRedeemedEvent.Event

local codesStore = DataStoreService:GetDataStore(CONFIG.CodesDataStore)
local redeemedStore = DataStoreService:GetDataStore(CONFIG.RedeemedDataStore)

-- Reads of what the bot wrote skip the server's DataStore cache (Roblox keeps a read for 4 s): otherwise a second
-- change made on Discord a moment after the first one reads the old copy and waits for the next poll (up to a minute)
local freshRead = nil
do
	local ok, options = pcall(function()
		local o = Instance.new("DataStoreGetOptions")
		o.UseCache = false
		return o
	end)
	if ok then
		freshRead = options
	end
end
Core.FreshRead = freshRead

local NUMBER_CLASSES = { "IntValue", "NumberValue" }
local ITEM_CLASSES = { "BoolValue", "IntValue", "NumberValue" }

local activeCodes = {}
local codeMeta = {} -- [CODE] = { origin = "game" | "discord", by = the Roblox name of who made it in the game }
local started = false
local busy = {}
local lastAttempt = {}
local redeemedCache = {}
local lastMissRefresh = -100
local warned = {}
local filterCache = {}
local filterCacheSize = 0

local function normalize(text)
	return string.lower((string.gsub(tostring(text), "[^%w]", "")))
end

-- Roblox attribute names may only contain letters, digits and underscores
local function safeName(text)
	return (string.gsub(tostring(text), "[^%w_]", ""))
end

local function warnOnce(key, message)
	if not warned[key] then
		warned[key] = true
		warn("[DiscordCodes] " .. message)
	end
end

-- Text typed on Discord (names of rewards, pets, currencies, events) is filtered like any other text shown to players.
-- Returns nil if it can't be filtered yet (e.g. no player on this server).
function Core.FilterText(text, fromUserId)
	text = tostring(text or "")
	if text == "" then
		return ""
	end
	if filterCache[text] then
		return filterCache[text]
	end
	local senders = {}
	if fromUserId then
		table.insert(senders, fromUserId)
	end
	if game.CreatorType == Enum.CreatorType.User then
		table.insert(senders, game.CreatorId)
	end
	for _, other in ipairs(Players:GetPlayers()) do
		table.insert(senders, other.UserId)
	end
	for i, userId in ipairs(senders) do
		if i > 3 then -- the filter is down or busy, not this sender: don't ask it once per player on the server
			break
		end
		local ok, result = pcall(function()
			local filtered = TextService:FilterStringAsync(text, userId, Enum.TextFilterContext.PublicChat)
			return filtered:GetNonChatStringForBroadcastAsync()
		end)
		if ok and type(result) == "string" then
			if filterCacheSize > 500 then
				filterCache, filterCacheSize = {}, 0
			end
			filterCache[text] = result
			filterCacheSize = filterCacheSize + 1
			return result
		end
	end
	return nil
end

-- The RemoteFunction / RemoteEvent of this kit in ReplicatedStorage. An object with the same name but another class
-- (from another system) is left alone: ours is made next to it and the log says what to rename.
function Core.FindRemote(name, className)
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local other = nil
	for _, child in ipairs(ReplicatedStorage:GetChildren()) do
		if child.Name == name then
			if child:IsA(className) then
				return child
			end
			other = child
		end
	end
	if other then
		warn("[DiscordCodes] ReplicatedStorage has '" .. name .. "' that is a " .. other.ClassName .. ", not a " .. className
			.. ". Rename that object (it belongs to something else); the players' windows need this name.")
	end
	local remote = Instance.new(className)
	remote.Name = name
	remote.Parent = ReplicatedStorage
	return remote
end

-- Settings -> MaxCurrencyPerCode (0 or missing = no limit)
local function currencyLimit()
	local ok, limit = pcall(function()
		local value = script.Parent:FindFirstChild("Settings"):FindFirstChild("MaxCurrencyPerCode")
		return tonumber(value.Value) or 0
	end)
	return ok and limit or 0
end

-- The limit as the bot sees it (Report sends it, so the bot warns about a code or gift above it)
function Core.CurrencyLimit()
	return currencyLimit()
end

-- A text for the server log when the reward is above the owner's limit, otherwise nil
local function overLimit(reward)
	local limit = currencyLimit()
	local currency = type(reward) == "table" and reward.currency or nil
	if limit > 0 and type(currency) == "table" and (tonumber(currency.amount) or 0) > limit then
		return "currency '" .. tostring(currency.name) .. "' amount " .. tostring(currency.amount)
			.. " is above Settings -> MaxCurrencyPerCode (" .. limit .. ")"
	end
	return nil
end

local function isOneOf(instance, classNames)
	for _, className in ipairs(classNames) do
		if instance:IsA(className) then
			return true
		end
	end
	return false
end

-- Finds EXACTLY ONE place in the player's data with one of the given names.
-- Returns the target, or nil + "missing" / "ambiguous" (+ the list of found paths).
local function findTarget(player, names, classNames, attributeTypes)
	local wanted = {}
	for _, name in ipairs(names) do
		wanted[normalize(name)] = true
	end
	local found = {}
	local function consider(instance)
		if wanted[normalize(instance.Name)] and isOneOf(instance, classNames) then
			table.insert(found, { kind = "value", instance = instance, path = instance:GetFullName() })
		end
	end
	for _, child in ipairs(player:GetChildren()) do
		if not CONFIG.IgnoredContainers[child.ClassName] and not CONFIG.IgnoredContainers[child.Name] then
			consider(child)
			for _, descendant in ipairs(child:GetDescendants()) do
				consider(descendant)
			end
		end
	end
	for attributeName, value in pairs(player:GetAttributes()) do
		if wanted[normalize(attributeName)] and attributeTypes[type(value)] then
			table.insert(found, { kind = "attribute", name = attributeName, path = "player attribute '" .. attributeName .. "'" })
		end
	end
	if #found == 1 then
		return found[1]
	end
	if #found == 0 then
		return nil, "missing"
	end
	local paths = {}
	for _, target in ipairs(found) do
		table.insert(paths, target.path)
	end
	return nil, "ambiguous", paths
end

local function readTarget(player, target)
	if target.kind == "value" then
		return target.instance.Value
	end
	return player:GetAttribute(target.name)
end

local function writeTarget(player, target, value)
	if target.kind == "value" then
		target.instance.Value = value
	else
		player:SetAttribute(target.name, value)
	end
end

-- A reward step that can be undone
local function makeStep(player, target, transform)
	local previous
	local applied = false
	return {
		apply = function()
			previous = readTarget(player, target)
			writeTarget(player, target, transform(previous))
			applied = true
		end,
		undo = function()
			if applied then
				writeTarget(player, target, previous)
			end
		end,
	}
end

local function describeProblem(label, problem, paths)
	if problem == "ambiguous" then
		return label .. " - several places match (" .. table.concat(paths, ", ") .. "), not sure which one to use"
	end
	return label .. " - not found"
end

-- Plan for giving a reward: a list of steps, or nil + a list of problems. Changes nothing yet.
local function buildPlan(player, reward)
	local steps = {}
	local problems = {}
	local function add(label, target, problem, paths, transform)
		if target then
			table.insert(steps, makeStep(player, target, transform))
		else
			table.insert(problems, describeProblem(label, problem, paths))
		end
	end

	local currency = reward.currency
	if type(currency) == "table" and (tonumber(currency.amount) or 0) > 0 then
		local amount = tonumber(currency.amount)
		local target, problem, paths = findTarget(player, { currency.name }, NUMBER_CLASSES, { number = true })
		add("currency '" .. tostring(currency.name) .. "'", target, problem, paths, function(old)
			return (tonumber(old) or 0) + amount
		end)
	end

	if (tonumber(reward.exp) or 0) > 0 then
		local amount = tonumber(reward.exp)
		local target, problem, paths = findTarget(player, CONFIG.ExpNames, NUMBER_CLASSES, { number = true })
		add("EXP (EXP, XP or Experience)", target, problem, paths, function(old)
			return (tonumber(old) or 0) + amount
		end)
	end

	local item = reward.item
	if type(item) == "table" and item.name then
		if item.is_temporary then
			local duration = tonumber(item.duration_seconds) or 0
			local target, problem, paths = findTarget(player, { item.name .. "ExpiresAt" }, NUMBER_CLASSES, { number = true })
			add(
				"timed item '" .. tostring(item.name) .. "' (value " .. safeName(item.name) .. "_ExpiresAt)",
				target,
				problem,
				paths,
				function(old)
					local now = os.time()
					local base = now
					if type(old) == "number" and old > now then
						base = old
					end
					return base + duration
				end
			)
		else
			local target, problem, paths =
				findTarget(player, { item.name, "Has" .. item.name }, ITEM_CLASSES, { number = true, boolean = true })
			add("item '" .. tostring(item.name) .. "'", target, problem, paths, function(old)
				if type(old) == "boolean" then
					return true
				end
				return (tonumber(old) or 0) + 1
			end)
		end
	end

	if #problems > 0 then
		return nil, problems
	end
	return steps, nil
end

-- Runs all steps or none: on an error it undoes whatever was already changed
local function executePlan(steps)
	local done = {}
	for _, step in ipairs(steps) do
		local ok, err = pcall(step.apply)
		if not ok then
			pcall(step.undo)
			for i = #done, 1, -1 do
				pcall(done[i].undo)
			end
			return false, err
		end
		table.insert(done, step)
	end
	return true
end

-- ---------- Used by the Live module (gifts, eggs, the game report for /setup-roblox) ----------

-- The path of a value inside the player (e.g. "leaderstats.Coins"). A part named after the player (some games keep
-- data in a folder called like the player) becomes "Player", so no player names are ever sent to the bot.
local function relativePath(player, instance)
	local parts = {}
	local current = instance
	local userId = tostring(player.UserId)
	while current and current ~= player do
		local name = current.Name
		local lower = string.lower(name)
		if name == player.Name or name == player.DisplayName or string.find(name, userId, 1, true)
			or (#player.Name >= 5 and string.find(lower, string.lower(player.Name), 1, true)) then
			name = "Player"
		end
		table.insert(parts, 1, name)
		current = current.Parent
	end
	return table.concat(parts, ".")
end

-- Names (never amounts) of the values and attributes in a player's data that rewards can use, searched the same way
-- as for rewards. The bot shows them in /setup-roblox -> "What your game has", so the owner picks exact names.
function Core.DescribePlayerData(player, limit)
	limit = limit or 150
	local values = {}
	local function consider(instance)
		if #values < 2000 and isOneOf(instance, ITEM_CLASSES) then
			table.insert(values, { path = relativePath(player, instance), class = instance.ClassName })
		end
	end
	-- leaderstats is read first: a huge folder before it (e.g. Pets) never pushes it past the 2000 above
	local children = player:GetChildren()
	for pass = 1, 2 do
		for _, child in ipairs(children) do
			local ignored = CONFIG.IgnoredContainers[child.ClassName] or CONFIG.IgnoredContainers[child.Name]
			if not ignored and (child.Name == "leaderstats") == (pass == 1) then
				consider(child)
				for _, descendant in ipairs(child:GetDescendants()) do
					consider(descendant)
				end
			end
		end
	end
	-- the most useful first, so the limit cuts deep names (e.g. a big Pets folder) and never leaderstats
	local ranks = {}
	for _, entry in ipairs(values) do
		local lower = string.lower(entry.path)
		local _, depth = string.gsub(entry.path, "%.", "")
		ranks[entry] = { string.sub(lower, 1, 12) == "leaderstats." and 0 or 1, depth, lower }
	end
	table.sort(values, function(a, b)
		local aRank, bRank = ranks[a], ranks[b]
		if aRank[1] ~= bRank[1] then
			return aRank[1] < bRank[1]
		end
		if aRank[2] ~= bRank[2] then
			return aRank[2] < bRank[2]
		end
		return aRank[3] < bRank[3]
	end)
	while #values > limit do
		table.remove(values)
	end
	local attributes = {}
	for name, value in pairs(player:GetAttributes()) do
		if type(value) == "number" or type(value) == "boolean" then
			table.insert(attributes, { name = name, type = type(value) })
		end
	end
	table.sort(attributes, function(a, b)
		return a.name < b.name
	end)
	return values, attributes
end

-- Gives a reward right away, with the same rules as codes: Core.OnReward first, then the automatic mode.
-- refund: true when it gives back what the player paid (an egg's price): Settings -> MaxCurrencyPerCode limits codes
-- and gifts, never the player's own money.
-- Returns true, or false + "unsupported" / "error" / "hook_error" + details.
function Core.GiveReward(player, reward, refund)
	if type(reward) ~= "table" then
		return false, "error", "no reward"
	end
	local tooMuch = not refund and overLimit(reward)
	if tooMuch then
		return false, "unsupported", tooMuch
	end
	if refund then
		reward.refund = true -- your OnReward gives exactly this back (no multipliers): see the top of this file
	end
	if Core.OnReward then
		local hookOk, handled = pcall(Core.OnReward, player, reward)
		if not hookOk then
			return false, "hook_error", tostring(handled)
		end
		if handled == true then
			return true
		end
		-- your own save system decides: the automatic mode would write into a copy that is lost on the next join
		return false, "unsupported", "Core.OnReward returned false (nothing was given)"
	end
	local plan, problems = buildPlan(player, reward)
	if not plan then
		return false, "unsupported", table.concat(problems, "; ")
	end
	local applied, applyError = executePlan(plan)
	if not applied then
		return false, "error", tostring(applyError)
	end
	return true
end

-- Whether a reward can be given (always true when Core.OnReward is set, because then your code decides)
function Core.CanGive(player, reward)
	local tooMuch = overLimit(reward)
	if tooMuch then
		return false, tooMuch
	end
	if Core.OnReward then
		return true
	end
	local plan, problems = buildPlan(player, reward)
	if plan then
		return true
	end
	return false, table.concat(problems, "; ")
end

-- Takes currency from the player: Core.OnSpend if you set it, otherwise the automatic mode.
-- Returns true, or false + "poor" (not enough) / "unsupported" (currency not found) / "error".
function Core.Spend(player, currencyName, amount)
	amount = tonumber(amount) or 0
	if amount <= 0 then
		return true
	end
	if Core.OnSpend then
		local hookOk, paid = pcall(Core.OnSpend, player, currencyName, amount)
		if not hookOk then
			warn("[DiscordCodes] Error in Core.OnSpend: " .. tostring(paid))
			return false, "error"
		end
		if paid == true then
			return true
		end
		return false, "poor"
	end
	local target, problem, paths = findTarget(player, { currencyName }, NUMBER_CLASSES, { number = true })
	if not target then
		warnOnce(
			"spend|" .. tostring(currencyName) .. "|" .. tostring(problem),
			describeProblem("currency '" .. tostring(currencyName) .. "'", problem, paths)
				.. ". Use the same currency name as in the game or add Core.OnSpend (see the top of the Core file)."
		)
		return false, "unsupported"
	end
	local balance = tonumber(readTarget(player, target)) or 0
	if balance < amount then
		return false, "poor"
	end
	local ok, err = pcall(writeTarget, player, target, balance - amount)
	if not ok then
		warn("[DiscordCodes] Could not take currency: " .. tostring(err))
		return false, "error"
	end
	return true
end

-- A DataStore error of Studio without "Enable Studio Access to API Services" (Roblox writes "studio" in lower case
-- in some of these errors, e.g. "Cannot write to DataStore from studio if API access is disabled")
function Core.IsStudioError(err)
	return string.find(string.lower(tostring(err)), "studio", 1, true) ~= nil
end

-- Reads what the bot saved (refresh = Core.Refresh, Live.RefreshEvents or Live.RefreshEggs), one read of an entry at
-- a time: a read that started before a change and ended after a newer read would put the older data back. A
-- notification during a read asks for one more read after it. `at` = when the bot saved the change: if the data read
-- is older (or the read failed), it is read again 5 s later, at most 3 times, instead of waiting for the next poll.
local refreshes = {}

function Core.RefreshUntilFresh(refresh, at)
	local state = refreshes[refresh]
	if not state then
		state = { attempts = 0 }
		refreshes[refresh] = state
	end
	at = tonumber(at)
	if at and at > (state.at or 0) then
		state.at = at
		state.attempts = 0
	end
	if state.running then
		state.again = true
		return
	end
	state.running = true
	state.again = false
	local called, ok, updatedAt = pcall(refresh)
	state.running = false
	if not called then
		warn("[DiscordCodes] Error while reading the data from the bot: " .. tostring(ok))
		ok = false
	end
	if state.again then
		Core.RefreshUntilFresh(refresh)
	elseif state.at and (not ok or (tonumber(updatedAt) or 0) < state.at) and state.attempts < 3 then
		state.attempts = state.attempts + 1
		task.delay(5, Core.RefreshUntilFresh, refresh)
	end
end

-- Returns ok and the time the bot saved the codes (updated_at)
function Core.Refresh()
	local ok, result = pcall(function()
		return codesStore:GetAsync(CONFIG.CodesEntryKey, freshRead)
	end)
	if not ok then
		local text = tostring(result)
		if Core.IsStudioError(text) then
			warnOnce(
				"studio",
				"DataStore is not available in Studio. Turn on: File -> Experience Settings -> Security -> Enable Studio Access to API Services, then Save."
			)
		else
			warn("[DiscordCodes] Could not load the codes: " .. text)
		end
		return false
	end
	if type(result) == "table" and type(result.codes) == "table" then
		activeCodes = result.codes
		codeMeta = type(result.meta) == "table" and result.meta or {}
	else
		activeCodes = {}
		codeMeta = {}
	end
	return true, type(result) == "table" and tonumber(result.updated_at) or nil
end

function Core.GetActiveCodes()
	return activeCodes
end

-- Who made each code: { [CODE] = { origin = "game" or "discord", by = name } } (codes from older bots have none)
function Core.GetCodeMeta()
	return codeMeta
end

-- ---------- Changes made by the game itself (the ⚙️ Manager, see the Control module) ----------

-- This server's own mark in its notifications: a server never reads again what it just saved itself
local serverMark = HttpService:GenerateGUID(false)

-- Seconds since 1970 with milliseconds (two saves in one second still differ)
function Core.Now()
	local ok, now = pcall(function()
		return DateTime.now().UnixTimestampMillis / 1000
	end)
	return ok and now or os.time()
end

-- The time to save as updated_at: now, and never older than the save before it (the bot's clock may be ahead)
function Core.SaveTime(previous)
	local value = math.max(Core.Now(), (tonumber(previous) or 0) + 0.001)
	return math.floor(value * 1000 + 0.5) / 1000
end

-- Tells every game server (this one too, on older files) that something changed. Returns ok, error.
function Core.Publish(topic, payload)
	payload.from = serverMark
	local ok, err = pcall(function()
		MessagingService:PublishAsync(topic, HttpService:JSONEncode(payload))
	end)
	if not ok then
		warn("[DiscordCodes] Could not tell the other servers (they read it within " .. CONFIG.PollIntervalSeconds
			.. " s by themselves): " .. tostring(err))
	end
	return ok, err
end

-- A notification this server sent itself
function Core.IsOwnMessage(data)
	return type(data) == "table" and data.from == serverMark
end

-- Changes the codes saved in the game: change(data) gets the entry (data.codes, data.meta) inside one UpdateAsync
-- (two servers saving at once never overwrite each other; the function may run more than once) and returns true to
-- save it. Ended codes are left out. Returns ok and the saved entry (nil when change() saved nothing), or false and
-- the error. Every server reads the new codes at once; this one uses them right away.
function Core.ChangeCodes(change)
	local saved = nil
	local ok, err = pcall(function()
		codesStore:UpdateAsync(CONFIG.CodesEntryKey, function(old)
			saved = nil
			local data = type(old) == "table" and old or {}
			data.codes = type(data.codes) == "table" and data.codes or {}
			data.meta = type(data.meta) == "table" and data.meta or {}
			local now = os.time()
			for code, reward in pairs(data.codes) do
				local ends = type(reward) == "table" and tonumber(reward.expires_at) or 0
				if type(reward) ~= "table" or (ends > 0 and ends <= now) then
					data.codes[code] = nil
				end
			end
			for code in pairs(data.meta) do
				if data.codes[code] == nil then
					data.meta[code] = nil
				end
			end
			if not change(data) then
				return nil
			end
			data.version = math.max(2, tonumber(data.version) or 0)
			data.updated_at = Core.SaveTime(data.updated_at)
			saved = data
			return data
		end)
	end)
	if not ok then
		return false, tostring(err)
	end
	if saved then
		activeCodes = saved.codes
		codeMeta = saved.meta
		Core.Publish(CONFIG.MessagingTopic, { type = "refresh", at = saved.updated_at })
	end
	return true, saved
end

-- For testing (the ⚙️ Manager): forget that this player redeemed the code, so they can redeem it again.
-- Returns true, or false + the error.
function Core.ForgetRedeemed(player, code)
	code = string.upper((string.gsub(tostring(code), "%s+", "")))
	local ok, err = pcall(function()
		redeemedStore:RemoveAsync(tostring(player.UserId) .. "_" .. code)
	end)
	if ok and redeemedCache[player] then
		redeemedCache[player][code] = nil
	end
	return ok, ok and nil or tostring(err)
end

-- For the ⚙️ Manager: what redeeming this code would do now for this player, without using it up or giving anything.
-- Returns the message key a real attempt would get (ok, invalid, expired, already, unsupported, unknown), the
-- reason in words for "unsupported" (may name things written on Discord: filter it before showing) and the reward.
function Core.TestCode(player, input)
	if type(input) ~= "string" then
		return "invalid"
	end
	local code = string.upper((string.gsub(input, "%s+", "")))
	if #code == 0 or #code > CONFIG.MaxCodeLength then
		return "invalid"
	end
	local reward = activeCodes[code]
	if reward == nil and os.clock() - lastMissRefresh > 10 then
		-- added on Discord a moment ago: refreshed like for a real attempt (at most every 10 s per server)
		lastMissRefresh = os.clock()
		Core.Refresh()
		reward = activeCodes[code]
	end
	if type(reward) ~= "table" then
		return "invalid"
	end
	if (tonumber(reward.expires_at) or 0) > 0 and os.time() >= tonumber(reward.expires_at) then
		return "expired", nil, reward
	end
	local tooMuch = overLimit(reward)
	if tooMuch then
		return "unsupported", tooMuch, reward
	end
	if not Core.OnReward then
		local plan, problems = buildPlan(player, reward)
		if not plan then
			return "unsupported", table.concat(problems, "; "), reward
		end
	end
	if redeemedCache[player] and redeemedCache[player][code] then
		return "already", nil, reward
	end
	local ok, value = pcall(function()
		return redeemedStore:GetAsync(tostring(player.UserId) .. "_" .. code)
	end)
	if not ok then
		return "unknown", nil, reward
	end
	return value ~= nil and "already" or "ok", nil, reward
end

-- Copy of the reward sent to the player's window to show exactly what they got (names filtered like chat text)
function Core.RewardSummary(reward, player)
	local summary = {}
	local userId = player and player.UserId or nil
	if type(reward.currency) == "table" and (tonumber(reward.currency.amount) or 0) > 0 then
		summary.currency = {
			name = Core.FilterText(reward.currency.name, userId) or "?",
			amount = tonumber(reward.currency.amount),
		}
	end
	if (tonumber(reward.exp) or 0) > 0 then
		summary.exp = tonumber(reward.exp)
	end
	if type(reward.item) == "table" and reward.item.name then
		summary.item = {
			name = Core.FilterText(reward.item.name, userId) or "?",
			is_temporary = reward.item.is_temporary == true,
			duration_seconds = tonumber(reward.item.duration_seconds) or 0,
		}
	end
	return summary
end
local rewardSummary = Core.RewardSummary

local function redeemInner(player, input)
	if type(input) ~= "string" then
		return false, "invalid"
	end
	local code = string.upper((string.gsub(input, "%s+", "")))
	if #code == 0 or #code > CONFIG.MaxCodeLength then
		return false, "invalid"
	end

	local now = os.clock()
	if lastAttempt[player] and now - lastAttempt[player] < CONFIG.CooldownSeconds then
		return false, "cooldown"
	end
	lastAttempt[player] = now

	local cache = redeemedCache[player]
	if cache and cache[code] then
		return false, "already"
	end

	local reward = activeCodes[code]
	if reward == nil and now - lastMissRefresh > 10 then
		-- the code may have been added a moment ago: refresh the list (at most every 10 s per server)
		lastMissRefresh = now
		Core.Refresh()
		reward = activeCodes[code]
	end
	if type(reward) ~= "table" then
		return false, "invalid"
	end
	if (tonumber(reward.expires_at) or 0) > 0 and os.time() >= tonumber(reward.expires_at) then
		return false, "expired"
	end
	local tooMuch = overLimit(reward)
	if tooMuch then
		warnOnce(code .. "|limit", "Code '" .. code .. "' can't be redeemed: " .. tooMuch .. ". The code was NOT used up.")
		return false, "unsupported"
	end

	-- Without a custom OnReward we check BEFORE using up the code that the whole reward can be given
	local plan, problems
	if not Core.OnReward then
		plan, problems = buildPlan(player, reward)
		if not plan then
			warnOnce(
				code .. "|" .. table.concat(problems, "|"),
				"Code '"
					.. code
					.. "' can't be redeemed: "
					.. table.concat(problems, "; ")
					.. ". The code was NOT used up. Use the same names in the bot (/setup-roblox -> What your game has) as in the game "
					.. "or add Core.OnReward (see the top of the Core file)."
			)
			return false, "unsupported"
		end
	end

	local key = tostring(player.UserId) .. "_" .. code
	local alreadyRedeemed = false
	local ok, err = pcall(function()
		redeemedStore:UpdateAsync(key, function(old)
			alreadyRedeemed = old ~= nil
			if old ~= nil then
				return nil
			end
			return os.time()
		end)
	end)
	if not ok then
		warn("[DiscordCodes] Could not save the redeemed code: " .. tostring(err))
		return false, "error"
	end

	local function remember()
		redeemedCache[player] = redeemedCache[player] or {}
		redeemedCache[player][code] = true
	end
	local function release()
		pcall(function()
			redeemedStore:RemoveAsync(key)
		end)
	end

	if alreadyRedeemed then
		remember()
		return false, "already"
	end
	if not player.Parent then
		release()
		return false, "left"
	end

	if Core.OnReward then
		local hookOk, handled = pcall(Core.OnReward, player, reward)
		if not hookOk then
			remember()
			warn(
				"[DiscordCodes] Error in Core.OnReward for code '"
					.. code
					.. "': "
					.. tostring(handled)
					.. ". The code was marked as redeemed so an error halfway through can't be used to get the reward again. Fix OnReward."
			)
			return false, "error"
		end
		if handled == true then
			remember()
			codeRedeemedEvent:Fire(player, code, reward)
			return true, "ok", rewardSummary(reward, player)
		end
		-- false/nil: your save system can't give it now (e.g. the profile isn't loaded): the code is released
		release()
		warnOnce(
			code .. "|hook",
			"Code '" .. code .. "': Core.OnReward returned false, so nothing was given. The code was NOT used up."
		)
		return false, "unsupported"
	end

	local applied, applyError = executePlan(plan)
	if not applied then
		release()
		warn("[DiscordCodes] Error while giving the reward (changes undone, code not used up): " .. tostring(applyError))
		return false, "error"
	end
	remember()
	codeRedeemedEvent:Fire(player, code, reward)
	return true, "ok", rewardSummary(reward, player)
end

-- (player, text) -> (boolean, message key, rewards on success)
-- Keys: ok, invalid, expired, already, busy, cooldown, unsupported, error, left
function Core.RedeemCode(player, input)
	if busy[player] then
		return false, "busy"
	end
	busy[player] = true
	local ok, success, messageKey, rewards = pcall(redeemInner, player, input)
	busy[player] = nil
	if not ok then
		warn("[DiscordCodes] Unexpected error: " .. tostring(success))
		return false, "error"
	end
	return success, messageKey, rewards
end

function Core.Start()
	if started then
		return
	end
	started = true

	Players.PlayerRemoving:Connect(function(player)
		busy[player] = nil
		lastAttempt[player] = nil
		redeemedCache[player] = nil
	end)

	Core.RefreshUntilFresh(Core.Refresh)

	task.spawn(function()
		while true do
			task.wait(CONFIG.PollIntervalSeconds)
			Core.RefreshUntilFresh(Core.Refresh)
		end
	end)

	task.spawn(function()
		-- Roblox may refuse for a moment (e.g. right after the server starts): tried again later, the codes still
		-- refresh every PollIntervalSeconds in the meantime
		for attempt = 1, 8 do
			local ok, err = pcall(function()
				MessagingService:SubscribeAsync(CONFIG.MessagingTopic, function(message)
					local decoded, data = pcall(function()
						return HttpService:JSONDecode(message.Data)
					end)
					if decoded and Core.IsOwnMessage(data) then
						return -- saved here a moment ago: this server already has it
					end
					local at = decoded and type(data) == "table" and data.at or nil
					-- random delay so that all servers don't load the data in the same second
					task.delay(math.random() * 3, Core.RefreshUntilFresh, Core.Refresh, at)
				end)
			end)
			if ok then
				return
			end
			if attempt == 1 then
				warn("[DiscordCodes] Could not subscribe to notifications, trying again (codes still refresh every "
					.. CONFIG.PollIntervalSeconds .. " s): " .. tostring(err))
			elseif attempt == 8 then
				warn("[DiscordCodes] Gave up subscribing to notifications on this server: new codes show here within "
					.. CONFIG.PollIntervalSeconds .. " s instead of at once: " .. tostring(err))
				return
			end
			task.wait(math.min(15 * 2 ^ attempt, 600))
		end
	end)

	local count = 0
	for _ in pairs(activeCodes) do
		count = count + 1
	end
	print("[DiscordCodes] Ready. Active codes: " .. count .. (freshRead and "" or " (fresh reads unavailable: changes may take up to 5 s longer)"))
end

return Core
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXC6200E6492A6402E873BBC3E81DB73EE">
			<Properties>
				<string name="Name">Report</string>
				<ProtectedString name="Source"><![CDATA[--!nonstrict
--[[
	DiscordCodes / Report  (ModuleScript)

	Tells the Discord bot two things, so /setup-roblox can help the game's owner:
	- which version of the DiscordCodes file runs in each place (published game and Studio separately),
	- what the game has: names of the values in player data (e.g. leaderstats.Coins, Pets.Dragon), egg spots and
	  models, the multipliers your code asks Live.GetMultiplier for and which of your own functions are set
	  (Core.OnReward, Core.OnSpend, Live.OnHatch, Live.OnAnnouncement) and the limit Settings -> MaxCurrencyPerCode,
	- the game catalog, if the game has the ModuleScript "DiscordCatalog" (DiscordCatalog.rbxmx from the bot's "scripts"
	  folder): the exact names of currencies, items, pets, eggs and multipliers, so the bot suggests them in its commands.
	Only names are sent, never amounts or player names (a folder called like a player is sent as "Player"). At most one
	small DataStore write per server start, and later only when something changed (or every 12 hours).
	Every server sees only its own players, so the names from all servers are joined in the saved report (up to
	ScanMaxValues); a report older than 12 hours starts again from scratch, so removed names disappear. Egg spots, egg
	models and the functions are the same on every server, so the newest report replaces them at once.
]]

local CollectionService = game:GetService("CollectionService")
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

local Core = require(script.Parent:WaitForChild("Core"))

local CONFIG = {
	DataStore = "DiscordLiveContent", -- these names must match the bot
	VersionKey = "KitVersions",
	ScanKey = "GameScan",
	RefreshSeconds = 43200,
	MaxPlaces = 20,
	ScanDelaySeconds = 15, -- wait after joining so your game can load the player's data first
	ScanIntervalSeconds = 30,
	ScanMaxValues = 150,
	ScanMaxList = 100, -- spots, models, multipliers, attributes, functions: at most this many of each in the report
	EggSpotTag = "DiscordEggSpot",
	EggTemplatesFolder = "DiscordEggs",
	CatalogKey = "GameCatalog",
	CatalogName = "DiscordCatalog", -- a ModuleScript in ServerScriptService (or ServerStorage / ReplicatedStorage)
	CatalogMaxNameLength = 100, -- characters; a longer name is reported, never cut (it must stay exact)
	CatalogTimeoutSeconds = 10, -- a DiscordCatalog that takes longer to load is reported as a problem
	CatalogLimits = { Currencies = 50, Items = 300, Pets = 500, Eggs = 100, Multipliers = 50, EggPets = 100, SoldForRobux = 500 },
}

local Report = { Config = CONFIG }

local store = DataStoreService:GetDataStore(CONFIG.DataStore)
local options = { version = 0, edition = "full", live = nil }
local started = false

local scanValues = {} -- path -> class, from every player on this server
local scanValueCount = 0
local scanAttributes = {} -- name -> "number" / "boolean"
local scannedPlayers = 0
local lastScanSignature = ""
local lastScanWrite = 0
local lastCatalogSignature = ""
local lastCatalogWrite = 0
local lastCatalogPrinted = ""

local function isStudioError(err)
	return Core.IsStudioError(err)
end

local function lastReport(place)
	local newest = 0
	for _, kind in ipairs({ "live", "studio" }) do
		if type(place) == "table" and type(place[kind]) == "table" then
			newest = math.max(newest, tonumber(place[kind].at) or 0)
		end
	end
	return newest
end

-- Keeps only the places that reported most recently
local function trimPlaces(places)
	local keys = {}
	for key in pairs(places) do
		table.insert(keys, key)
	end
	if #keys > CONFIG.MaxPlaces then
		table.sort(keys, function(a, b)
			return lastReport(places[a]) > lastReport(places[b])
		end)
		for i = CONFIG.MaxPlaces + 1, #keys do
			places[keys[i]] = nil
		end
	end
end

-- Writes `entry` for this place (published game or Studio) unless the same is already saved (and not too old)
-- keep(current), optional: true = the saved entry must stay (e.g. it comes from a newer version of the game)
-- merge(current, entry), optional: joins a fresh saved entry with this server's entry (servers see different players)
local function save(key, entry, same, keep, merge)
	local kind = RunService:IsStudio() and "studio" or "live"
	local placeKey = tostring(game.PlaceId)
	local now = os.time()
	return pcall(function()
		store:UpdateAsync(key, function(old)
			local data = type(old) == "table" and old or {}
			if type(data.places) ~= "table" then
				data.places = {}
			end
			local place = type(data.places[placeKey]) == "table" and data.places[placeKey] or {}
			local current = place[kind]
			if type(current) == "table" and keep and keep(current) then
				return nil
			end
			local fresh = type(current) == "table" and now - (tonumber(current.at) or 0) < CONFIG.RefreshSeconds
			local value = entry
			if merge and fresh then
				value = merge(current, entry)
			end
			if fresh and same(current, value) then
				return nil -- already known, nothing to write
			end
			local copy = {}
			for k, v in pairs(value) do
				copy[k] = v
			end
			copy.at = (merge and fresh) and (tonumber(current.at) or now) or now
			copy.saved = now -- "at" is the start of the 12-hour window of a joined report; this is the newest write
			place[kind] = copy
			data.places[placeKey] = place
			trimPlaces(data.places)
			return data
		end)
	end)
end

function Report.Setup(newOptions)
	for key, value in pairs(newOptions or {}) do
		options[key] = value
	end
end

-- ---------- File version ----------

function Report.ReportVersion(version)
	version = tonumber(version or options.version)
	if not version then
		return false
	end
	local edition = options.edition
	local ok, err = save(CONFIG.VersionKey, { version = version, edition = edition }, function(current)
		return tonumber(current.version) == version and (current.edition or "full") == edition
	end, function(current)
		-- a server still running an older file (started before the publish) never hides the newer one. Not in Studio:
		-- there only one file runs, so an older file put back into Studio is reported at once
		return not RunService:IsStudio() and tonumber(current.version) ~= nil and tonumber(current.version) > version
			and os.time() - (tonumber(current.at) or 0) < CONFIG.RefreshSeconds
	end)
	if not ok and not isStudioError(err) then
		warn("[DiscordCodes] Could not report the file version to the bot: " .. tostring(err))
	end
	return ok
end

-- ---------- What the game has ----------

local function sortedKeys(map)
	local keys = {}
	for key in pairs(map) do
		table.insert(keys, key)
	end
	table.sort(keys)
	return keys
end

local function spotName(spot)
	local name = spot:GetAttribute("Spot")
	if type(name) == "string" and name ~= "" then
		return name
	end
	return spot.Name
end

function Report.ScanPlayer(player)
	if not player.Parent then
		return
	end
	local ok, values, attributes = pcall(Core.DescribePlayerData, player, CONFIG.ScanMaxValues)
	if not ok then
		return
	end
	scannedPlayers = scannedPlayers + 1
	for _, value in ipairs(values) do
		if not scanValues[value.path] and scanValueCount < CONFIG.ScanMaxValues then
			scanValues[value.path] = value.class
			scanValueCount = scanValueCount + 1
		end
	end
	for _, attribute in ipairs(attributes) do
		scanAttributes[attribute.name] = attribute.type
	end
end

function Report.ScanGame()
	local values, attributes, spots, templates, multipliers, hooks = {}, {}, {}, {}, {}, {}
	for _, path in ipairs(sortedKeys(scanValues)) do
		table.insert(values, path .. ":" .. scanValues[path])
	end
	for _, name in ipairs(sortedKeys(scanAttributes)) do
		table.insert(attributes, name .. ":" .. scanAttributes[name])
	end
	for _, spot in ipairs(CollectionService:GetTagged(CONFIG.EggSpotTag)) do
		if spot:IsDescendantOf(Workspace) and (spot:IsA("BasePart") or spot:IsA("Model")) then
			table.insert(spots, spotName(spot))
		end
	end
	table.sort(spots)
	local folder = ReplicatedStorage:FindFirstChild(CONFIG.EggTemplatesFolder)
	if folder then
		for _, child in ipairs(folder:GetChildren()) do
			if child:IsA("Model") or child:IsA("BasePart") then
				table.insert(templates, child.Name)
			end
		end
		table.sort(templates)
	end
	local live = options.live
	if live and live.GetUsedMultipliers then
		multipliers = live.GetUsedMultipliers()
	end
	local functions = { { "OnReward", Core.OnReward }, { "OnSpend", Core.OnSpend } }
	if live then
		table.insert(functions, { "OnHatch", live.OnHatch })
		table.insert(functions, { "OnAnnouncement", live.OnAnnouncement })
	end
	for _, hook in ipairs(functions) do
		if hook[2] then
			table.insert(hooks, hook[1])
		end
	end
	return {
		values = values,
		attributes = attributes,
		spots = spots,
		spotCount = #spots, -- copies of one part keep its name: the list of names alone would count them once
		templates = templates,
		multipliers = multipliers,
		hooks = hooks,
		maxCurrency = Core.CurrencyLimit(), -- 0 = no limit
		players = scannedPlayers,
	}
end

local SCAN_LISTS = { "values", "attributes", "spots", "templates", "multipliers", "hooks" }

local function scanSignature(scan)
	local parts = {}
	for _, key in ipairs(SCAN_LISTS) do
		-- the same names in another order are the same report (no new write just for the order)
		local list = table.clone and table.clone(type(scan[key]) == "table" and scan[key] or {}) or { table.unpack(scan[key] or {}) }
		table.sort(list)
		table.insert(parts, key .. "=" .. table.concat(list, ","))
	end
	table.insert(parts, "maxCurrency=" .. tostring(tonumber(scan.maxCurrency) or 0))
	table.insert(parts, "spotCount=" .. tostring(tonumber(scan.spotCount) or 0))
	return table.concat(parts, "|")
end

-- For the names in player data: leaderstats first, then short paths, then the rest (letter case ignored), so a cut at
-- the limit drops deep names (pets, items by id) and never the currencies
local function usefulFirst(x, y)
	local function rank(value)
		local lower = string.lower(value)
		local _, depth = string.gsub(value, "%.", "")
		return string.sub(lower, 1, 12) == "leaderstats." and 0 or 1, depth, lower
	end
	local xLeader, xDepth, xName = rank(x)
	local yLeader, yDepth, yName = rank(y)
	if xLeader ~= yLeader then
		return xLeader < yLeader
	end
	if xDepth ~= yDepth then
		return xDepth < yDepth
	end
	return xName < yName
end

-- Sorted list of the entries of both lists (no duplicates), at most `limit`
local function union(a, b, limit, order)
	local seen, result = {}, {}
	for _, list in ipairs({ a, b }) do
		for _, value in ipairs(type(list) == "table" and list or {}) do
			if type(value) == "string" and not seen[value] then
				seen[value] = true
				table.insert(result, value)
			end
		end
	end
	table.sort(result, order)
	while #result > limit do
		table.remove(result)
	end
	return result
end

-- Lists that are the same on every server of one place version (egg spots, egg models, the game's own functions; the
-- currency limit too): the newest scan replaces them, so a removed spot, model or function disappears at once instead of after 12 hours.
-- A server still running an older version of the place (started before a publish) never replaces the newer lists.
local GAME_WIDE = { spots = true, templates = true, hooks = true }

-- The saved report of the other servers joined with this server's report
local function mergeScan(current, scan)
	local currentVersion, scanVersion = tonumber(current.placeVersion) or 0, tonumber(scan.placeVersion) or 0
	local merged = { players = math.max(tonumber(current.players) or 0, tonumber(scan.players) or 0),
		placeVersion = math.max(currentVersion, scanVersion),
		maxCurrency = tonumber(scanVersion >= currentVersion and scan.maxCurrency or current.maxCurrency) or 0,
		spotCount = tonumber(scanVersion >= currentVersion and scan.spotCount or current.spotCount) or 0 }
	for _, key in ipairs(SCAN_LISTS) do
		if GAME_WIDE[key] then
			merged[key] = union(scanVersion >= currentVersion and scan[key] or current[key], nil, CONFIG.ScanMaxList)
		else
			merged[key] = union(current[key], scan[key], key == "values" and CONFIG.ScanMaxValues or CONFIG.ScanMaxList,
				key == "values" and usefulFirst or nil)
		end
	end
	merged.sig = scanSignature(merged)
	return merged
end

-- Saves the report when something changed (or every 12 hours)
function Report.ReportGame()
	local scan = Report.ScanGame()
	local signature = scanSignature(scan)
	local now = os.time()
	if signature == lastScanSignature and now - lastScanWrite < CONFIG.RefreshSeconds then
		return true
	end
	scan.sig = signature
	scan.placeVersion = game.PlaceVersion
	local ok, err = save(CONFIG.ScanKey, scan, function(current, value)
		return current.sig == value.sig
	end, nil, mergeScan)
	if ok then
		lastScanSignature = signature
		lastScanWrite = now
	elseif not isStudioError(err) then
		warn("[DiscordCodes] Could not send the game report to the bot: " .. tostring(err))
	end
	return ok
end

-- ---------- The game catalog (the optional ModuleScript "DiscordCatalog") ----------
-- The owner lists there what the game has (currencies, items, pets with rarity, eggs, multipliers). Only the names go
-- to the bot, so its commands can suggest them and refuse names the game doesn't have.
-- The module is read once per server (it doesn't change while the server runs), in its own thread with a time limit,
-- so a module that waits forever can't stop the other reports.

-- Deterministic text of a table (sorted keys), used to notice changes
local function stableText(value)
	if type(value) ~= "table" then
		return tostring(value)
	end
	local keys = {}
	for key in pairs(value) do
		table.insert(keys, key)
	end
	table.sort(keys, function(a, b)
		return tostring(a) < tostring(b)
	end)
	local parts = {}
	for _, key in ipairs(keys) do
		table.insert(parts, tostring(key) .. "=" .. stableText(value[key]))
	end
	return "{" .. table.concat(parts, ",") .. "}"
end

-- A number that can be saved (not NaN, not math.huge), or nil
local function finiteNumber(value)
	local number = tonumber(value)
	if number == nil or number ~= number or number == math.huge or number == -math.huge then
		return nil
	end
	return number
end

-- The name as text, or nil; a second result "long" when the name is too long (it is never cut, so it stays exact)
local function cleanName(value)
	if type(value) ~= "string" and type(value) ~= "number" then
		return nil
	end
	local text = string.match(tostring(value), "^%s*(.-)%s*$")
	if text == nil or text == "" then
		return nil
	end
	local length = utf8.len(text)
	if length == nil or length > CONFIG.CatalogMaxNameLength then
		return nil, "long"
	end
	return text
end

-- A problem in the catalog: a code for the bot (translated there) and an English text for the Output window
local function addProblem(catalog, code, what, detail, text)
	if #catalog.problems < 20 then
		table.insert(catalog.problems, { code = code, what = what, detail = detail })
		warn("[DiscordCodes] DiscordCatalog: " .. text)
	end
end

local function tooLong(catalog, what, value)
	local text = tostring(value)
	local cut = utf8.len(text) and utf8.offset(text, 21) -- whole characters only, so the text stays valid UTF-8
	local preview = cut and string.sub(text, 1, cut - 1) or (utf8.len(text) and text or "?")
	addProblem(catalog, "name_too_long", what, preview, what .. ": the name '" .. preview .. "...' is longer than "
		.. CONFIG.CatalogMaxNameLength .. " characters")
end

-- Entries of a list ({ "Coins", "Gems" }) or of a dictionary ({ Coins = true }), as { key, value, position }
local function entriesOf(value)
	local entries = {}
	if #value > 0 then
		for index, entry in ipairs(value) do
			table.insert(entries, { index, entry, index })
		end
	else
		for key, entry in pairs(value) do
			table.insert(entries, { key, entry, tostring(key) })
		end
		table.sort(entries, function(a, b)
			return tostring(a[1]) < tostring(b[1])
		end)
	end
	return entries
end

-- The name of an entry: the value in a list ({ "Coins" }), the key in a dictionary ({ Coins = true })
local function entryName(entry, field)
	if type(entry[1]) == "number" then
		if type(entry[2]) == "table" then
			return entry[2][field] or entry[2][string.lower(field)]
		end
		return entry[2]
	end
	return entry[1]
end

local function nameList(catalog, value, what)
	local result, seen = {}, {}
	if value == nil then
		return result
	end
	if type(value) ~= "table" then
		addProblem(catalog, "not_list", what, nil, what .. " must be a list, e.g. { 'Coins', 'Gems' }")
		return result
	end
	local limit = CONFIG.CatalogLimits[what]
	for _, entry in ipairs(entriesOf(value)) do
		local raw = entryName(entry, "Name")
		local name, problem = cleanName(raw)
		if problem == "long" then
			tooLong(catalog, what, raw)
		elseif not name then
			addProblem(catalog, "bad_name", what, tostring(entry[3]), what .. " #" .. tostring(entry[3]) .. " is not a name")
		elseif not seen[string.lower(name)] then
			if #result >= limit then
				addProblem(catalog, "too_many", what, tostring(limit), what .. ": only the first " .. limit .. " are sent")
				break
			end
			seen[string.lower(name)] = true
			table.insert(result, name)
		end
	end
	return result
end

local function petList(catalog, value)
	local result, seen = {}, {}
	if value == nil then
		return result
	end
	if type(value) ~= "table" then
		addProblem(catalog, "not_list", "Pets", nil, "Pets must be a list, e.g. { { Name = 'Dog', Rarity = 'Common' } }")
		return result
	end
	local limit = CONFIG.CatalogLimits.Pets
	for _, entry in ipairs(entriesOf(value)) do
		-- { Name = "Dog", Rarity = "Common" } or "Dog" in a list; Dog = "Common" or Dog = { Rarity = "Common" } by name
		local rarity = nil
		if type(entry[2]) == "table" then
			rarity = entry[2].Rarity or entry[2].rarity
		elseif type(entry[1]) ~= "number" then
			rarity = entry[2]
		end
		local raw = entryName(entry, "Name")
		local name, problem = cleanName(raw)
		if problem == "long" then
			tooLong(catalog, "Pets", raw)
		elseif not name then
			addProblem(catalog, "pet_no_name", "Pets", tostring(entry[3]), "Pets #" .. tostring(entry[3]) .. " has no Name")
		elseif not seen[string.lower(name)] then
			if #result >= limit then
				addProblem(catalog, "too_many", "Pets", tostring(limit), "Pets: only the first " .. limit .. " are sent")
				break
			end
			seen[string.lower(name)] = true
			table.insert(result, { name = name, rarity = (cleanName(rarity)) })
		end
	end
	return result
end

local function eggPets(catalog, value, egg)
	local pets = {}
	if type(value) ~= "table" then
		return pets
	end
	for _, pet in ipairs(entriesOf(value)) do
		-- Dog = 60 (a chance), "Dog" in a list (no chance), or { Name = "Dog", Chance = 60 } (Weight works too)
		local chance = nil
		if type(pet[2]) == "table" then
			chance = pet[2].Chance or pet[2].chance or pet[2].Weight or pet[2].weight
		elseif type(pet[1]) ~= "number" then
			chance = pet[2]
		end
		local raw = entryName(pet, "Name")
		local name, problem = cleanName(raw)
		if problem == "long" then
			tooLong(catalog, "Eggs", raw)
		elseif name and #pets < CONFIG.CatalogLimits.EggPets then
			table.insert(pets, { name = name, chance = finiteNumber(chance) })
		end
	end
	return pets
end

local function eggList(catalog, value)
	local result, seen = {}, {}
	if value == nil then
		return result
	end
	if type(value) ~= "table" then
		addProblem(catalog, "not_list", "Eggs", nil, "Eggs must be a list, e.g. { { Name = 'Basic Egg', Pets = { Dog = 60 } } }")
		return result
	end
	for _, entry in ipairs(entriesOf(value)) do
		local data = type(entry[2]) == "table" and entry[2] or {}
		local raw = entryName(entry, "Name")
		local name, problem = cleanName(raw)
		if problem == "long" then
			tooLong(catalog, "Eggs", raw)
		elseif not name then
			addProblem(catalog, "egg_no_name", "Eggs", tostring(entry[3]), "Eggs #" .. tostring(entry[3]) .. " has no Name")
		elseif not seen[string.lower(name)] and #result < CONFIG.CatalogLimits.Eggs then
			seen[string.lower(name)] = true
			local pets = eggPets(catalog, data.Pets or data.pets, name)
			if #pets == 0 then
				addProblem(catalog, "egg_no_pets", "Eggs", name, "the egg " .. name .. " has no Pets")
			end
			table.insert(result, {
				name = name,
				currency = (cleanName(data.Currency or data.currency)),
				price = finiteNumber(data.Price or data.price),
				pets = pets,
			})
		end
	end
	return result
end

-- The example names of the DiscordCatalog template from older bot versions: such a catalog was never filled in
local TEMPLATE = { currencies = { "coins", "gems" }, items = { "speed coil", "vip pass" } }

local function lowerSorted(list, field)
	local result = {}
	for _, entry in ipairs(list) do
		table.insert(result, string.lower(tostring(field and entry[field] or entry)))
	end
	table.sort(result)
	return table.concat(result, ",")
end

local function isTemplate(catalog)
	return lowerSorted(catalog.currencies) == table.concat(TEMPLATE.currencies, ",")
		and lowerSorted(catalog.items) == table.concat(TEMPLATE.items, ",")
		and (#catalog.pets == 0 or lowerSorted(catalog.pets, "name") == "cat,dog,dragon")
end

function Report.FindCatalog()
	for _, service in ipairs({ ServerScriptService, ServerStorage, ReplicatedStorage }) do
		local module = service:FindFirstChild(CONFIG.CatalogName)
		if module and module:IsA("ModuleScript") then
			return module
		end
	end
	return nil
end

-- The catalog as plain lists of names, or nil when the game has no DiscordCatalog
function Report.ReadCatalog()
	local module = Report.FindCatalog()
	if not module then
		return nil
	end
	local catalog = { currencies = {}, items = {}, pets = {}, eggs = {}, multipliers = {}, robux = {}, problems = {} }
	local ok, data = pcall(require, module)
	if not ok then
		addProblem(catalog, "error", nil, string.sub(tostring(data), 1, 200), "it has an error: " .. tostring(data))
		return catalog
	end
	if type(data) ~= "table" then
		addProblem(catalog, "no_return", nil, nil, "the last line must be: return Catalog")
		return catalog
	end
	catalog.currencies = nameList(catalog, data.Currencies, "Currencies")
	catalog.items = nameList(catalog, data.Items, "Items")
	catalog.pets = petList(catalog, data.Pets)
	catalog.eggs = eggList(catalog, data.Eggs)
	catalog.multipliers = nameList(catalog, data.Multipliers, "Multipliers")
	-- what players can buy with Robux: the bot warns when a code or a gift gives it (Roblox rules on promo codes)
	catalog.robux = nameList(catalog, data.SoldForRobux, "SoldForRobux")
	if isTemplate(catalog) then
		addProblem(catalog, "template", nil, nil, "it still has only the example names of the template (Coins, Gems, VIP Pass, "
			.. "Speed Coil...). Write your game's real names into it; until then the bot does not use it.")
	end
	return catalog
end

-- Reads the catalog once per server, in its own thread. A module that waits forever (for example WaitForChild for
-- something that isn't there) is reported as a problem after CatalogTimeoutSeconds instead of stopping the reports.
local catalogLoad = { state = "new", value = nil }

local function loadCatalog()
	if catalogLoad.state == "done" then
		return true, catalogLoad.value
	end
	if catalogLoad.state == "loading" then
		return false
	end
	catalogLoad.state = "loading"
	local finished = false
	task.spawn(function()
		local value = Report.ReadCatalog()
		if not finished then
			finished = true
			catalogLoad.value = value
		end
	end)
	local waited = 0
	while not finished and waited < CONFIG.CatalogTimeoutSeconds do
		task.wait(0.5)
		waited = waited + 0.5
	end
	if not finished then
		finished = true
		local catalog = { currencies = {}, items = {}, pets = {}, eggs = {}, multipliers = {}, robux = {}, problems = {} }
		addProblem(catalog, "timeout", nil, tostring(CONFIG.CatalogTimeoutSeconds), "it did not finish loading in "
			.. CONFIG.CatalogTimeoutSeconds .. " s (is it waiting with WaitForChild for something that isn't there?)")
		catalogLoad.value = catalog
	end
	catalogLoad.state = "done"
	return true, catalogLoad.value
end

-- Reads DiscordCatalog again on the next report (for example after editing it while the server runs)
function Report.ForgetCatalog()
	catalogLoad.state, catalogLoad.value = "new", nil
	lastCatalogSignature = ""
	lastCatalogPrinted = ""
end

local function describeCatalog(catalog)
	if not catalog then
		return "none (optional: DiscordCatalog lets the bot know the exact names)"
	end
	local parts = { #catalog.currencies .. " currencies", #catalog.items .. " items" }
	if options.live then
		table.insert(parts, #catalog.pets .. " pets")
		table.insert(parts, #catalog.eggs .. " eggs")
		table.insert(parts, #catalog.multipliers .. " multipliers")
	end
	if catalog.robux and #catalog.robux > 0 then
		table.insert(parts, #catalog.robux .. " sold for Robux")
	end
	return table.concat(parts, ", ")
end

-- Sends the catalog when it changed (or every 12 hours). A game without one says so, so the bot can tell the owner.
-- A server running an older published version never overwrites the catalog of a newer one.
function Report.ReportCatalog()
	local loaded, catalog = loadCatalog()
	if not loaded then
		return false
	end
	local placeVersion = tonumber(game.PlaceVersion) or 0
	local entry = { placeVersion = placeVersion } -- a fresh table: saving adds "at" to it
	for key, value in pairs(catalog or { missing = true }) do
		entry[key] = value
	end
	local signature = stableText(entry)
	local now = os.time()
	if signature == lastCatalogSignature and now - lastCatalogWrite < CONFIG.RefreshSeconds then
		return true
	end
	local ok, err = save(CONFIG.CatalogKey, entry, function(current)
		local copy = {}
		for key, value in pairs(current) do
			if key ~= "at" and key ~= "saved" then -- the times of saving are not part of the catalog
				copy[key] = value
			end
		end
		return stableText(copy) == signature
	end, function(current)
		return (tonumber(current.placeVersion) or 0) > placeVersion
	end)
	if ok then
		lastCatalogSignature = signature
		lastCatalogWrite = now
		if signature ~= lastCatalogPrinted then
			lastCatalogPrinted = signature
			print("[DiscordCodes] Game catalog: " .. describeCatalog(catalog))
		end
	elseif isStudioError(err) then
		if signature ~= lastCatalogPrinted then
			lastCatalogPrinted = signature
			print("[DiscordCodes] Game catalog: " .. describeCatalog(catalog)
				.. " (not sent to the bot: turn on File -> Experience Settings -> Security -> Enable Studio Access to API Services, then Save)")
		end
	else
		warn("[DiscordCodes] Could not send the game catalog to the bot: " .. tostring(err))
	end
	return ok
end

-- ---------- Start ----------

function Report.Start(newOptions)
	Report.Setup(newOptions)
	if started then
		return
	end
	started = true
	task.spawn(Report.ReportVersion, options.version)
	task.spawn(Report.ReportCatalog)
	local function onPlayer(player)
		task.delay(CONFIG.ScanDelaySeconds, Report.ScanPlayer, player)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayer(player)
	end
	task.spawn(function()
		while true do
			task.wait(CONFIG.ScanIntervalSeconds)
			Report.ReportGame()
			Report.ReportCatalog()
		end
	end)
end

return Report
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXA6BB3B9C2CF945B6B30535B011E07509">
			<Properties>
				<string name="Name">Live</string>
				<ProtectedString name="Source"><![CDATA[--!nonstrict
--[[
	DiscordCodes / Live  (ModuleScript)

	Live content from the Discord bot, on every server within seconds and without publishing the game:
	- /event-start  -> multipliers (e.g. 2x Coins, 2x EXP, 1.5x luck in eggs) with a timer on the screen
	- /egg-create   -> eggs on stands, with pets and chances, bought with game currency
	- /give         -> a reward for one player (also delivered later if they are offline now)
	- /announce-game -> a message on the screen of every player

	EGGS: put a Part (or Model) where an egg should stand and give it the tag "DiscordEggSpot"
	(select the part, Properties -> Tags -> +, or CollectionService:AddTag). Optional: a "Spot" text attribute with a name,
	used by the bot's "spot" option. Your egg models go into ReplicatedStorage -> Folder "DiscordEggs"
	(a model named "Default" is used when the bot gives no template). Without models a simple colored egg is used.
	A rolled pet is given like a code item (a BoolValue/IntValue named like the pet in the player's data), or by
	your own function:

		local Live = require(game.ServerScriptService:WaitForChild("DiscordCodes"):WaitForChild("Live"))
		Live.OnHatch = function(player, egg, petName)
			-- add the pet to YOUR pet system here; return false if you couldn't (the price is refunded)
			return true
		end

	MULTIPLIERS: use one line where your game gives currency or EXP:
		amount = amount * Live.GetMultiplier("Coins")      -- or "EXP"; luck is used by eggs automatically

	YOUR OWN EGG SHOP OR DATA LOADING:
		Live.OpenEgg(player, eggId)   -- buy an egg from your own button/UI (Live.GetEggs() lists them)
		Live.GetChances(eggId)        -- the chances to SHOW in your UI ({ {name, chance}, ... }, with a luck event)
		Live.Config.PaidRandomItems = false  -- in your own script, only if no egg currency can be bought with Robux
		Live.Config.Pedestal = false     -- your egg spots already are pedestals (EggAnimation = false: eggs stand still)
		Live.DeliverGifts(player)     -- deliver waiting gifts right after your game loaded the player's data

	EVENTS FOR YOUR OWN CODE:
		Live.EventsChanged:Connect(function(events) ... end)
		Live.Hatched:Connect(function(player, egg, petName) ... end)
		Live.GiftReceived:Connect(function(player, reward, message) ... end)
		Live.OnAnnouncement = function(text, seconds) ... return true end  -- your own announcement UI

	Text written on Discord (announcements, egg, pet, currency and event names) is filtered by Roblox before players
	see it.

	The Report module tells the bot which multipliers your code asks for and which of the functions above you set,
	so /setup-roblox on Discord can warn about options that can't work in your game.
]]

local CollectionService = game:GetService("CollectionService")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local PolicyService = game:GetService("PolicyService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Core = require(script.Parent:WaitForChild("Core"))

local CONFIG = {
	LiveDataStore = "DiscordLiveContent", -- these three values must match the bot (config.json -> cloud_sync)
	GiftsDataStore = "DiscordGifts",
	MessagingTopic = "DiscordLive",
	PollIntervalSeconds = 60,
	EggSpotTag = "DiscordEggSpot",
	EggTemplatesFolder = "DiscordEggs",
	PromptText = "Open",
	Pedestal = true, -- a round pedestal with a glowing ring under each egg; false if your egg spots are pedestals already
	EggAnimation = true, -- eggs float up and down and turn slowly (on the players' devices only)
	RareChance = 5, -- pets with a chance up to this % count as rare: luck events make them more likely
	LuckLine = "⚡ Luck x%s", -- above the chances on an egg while a luck event runs (the chances shown include it)
	-- under the chances when one of them is rounded: the sentence Roblox requires for paid random items (keep it as is)
	RoundedLine = "Probabilities are rounded; total of displayed individual probabilities may not equal 100%.",
	-- Eggs bought with a currency players can buy with Robux are "paid random items" (Roblox Community Standards):
	-- players Roblox doesn't allow to buy them (PolicyService ArePaidRandomItemsRestricted) can't open eggs. Set false
	-- only if no egg currency in your game can be bought with Robux, directly or indirectly, and in YOUR OWN script
	-- (Live.Config.PaidRandomItems = false after require), not here: updating this file would bring it back.
	PaidRandomItems = true,
	OpenCooldownSeconds = 1,
	MaxMultiplier = 100,
	GiftDelaySeconds = 8, -- wait after joining so your game can load the player's data first
	-- A gift claimed by a server that stopped before finishing is given again only after this long. Long on purpose:
	-- a shorter time could give a gift twice if that server stopped right after giving it.
	StuckClaimSeconds = 86400,
	MaxGiftPages = 10, -- gifts read per join: up to 10 pages of 50
	RefundRetries = 3,
}

local Live = { Config = CONFIG, OnHatch = nil, OnAnnouncement = nil }

local eventsChanged = Instance.new("BindableEvent")
local hatchedEvent = Instance.new("BindableEvent")
local giftReceived = Instance.new("BindableEvent")
Live.EventsChanged = eventsChanged.Event
Live.Hatched = hatchedEvent.Event
Live.GiftReceived = giftReceived.Event

local remoteName = "DiscordLiveEvent"
local liveStore = DataStoreService:GetDataStore(CONFIG.LiveDataStore)
local giftsStore = DataStoreService:GetDataStore(CONFIG.GiftsDataStore)
local random = Random.new()

local remote = nil
local started = false
local activeEvents = {}
local localEvents = {} -- events of this server only (the ⚙️ Manager's "this server"): never saved, gone with the server
local localNumber = 0
local activeEggs = {}
local eventsSignature = ""
local eggsSignature = ""
local rendered = {}
local lastSpots = {} -- egg id -> the spot it stood on, so a change elsewhere doesn't move it
local standsFolder = nil
local pendingFilter = false
local renderQueued = false
local renderGeneration = 0 -- each drawing of the stands has its number: an older one that waited stops (see renderEggs)
local warned = {}
local lastOpen = {}
local lastHello = {}
local giftBusy = {}
local giftAgain = {}
local randomItemsAllowed = {} -- player -> true/false from PolicyService (nil: not checked yet)
local shownLuck = 1 -- the luck in the chances on the eggs; eggs roll with exactly this (see currentChances)

local function warnOnce(key, message)
	if not warned[key] then
		warned[key] = true
		warn("[DiscordLive] " .. message)
	end
end

local function normalize(text)
	return string.lower((string.gsub(tostring(text), "[^%w]", "")))
end

-- At most count characters (not bytes: a Polish letter takes 2 bytes, an emoji 4, and a cut inside one breaks the text)
local function firstChars(text, count)
	text = tostring(text or "")
	if not utf8.len(text) then -- not valid UTF-8 (never from Discord): cut by bytes, the filter checks it anyway
		return string.sub(text, 1, count)
	end
	local cut = utf8.offset(text, count + 1)
	return cut and string.sub(text, 1, cut - 1) or text
end

local function formatNumber(value)
	local digits = tostring(math.floor(tonumber(value) or 0))
	local grouped = ""
	while #digits > 3 do
		grouped = "," .. string.sub(digits, -3) .. grouped
		digits = string.sub(digits, 1, -4)
	end
	return digits .. grouped
end

-- Roblox (paid random items): the odds are shown as percentages; a chance may be rounded only to four or more decimal
-- places below its first non-zero digit (33.3333 -> 33.333, 0.0042 -> 0.0042), and a list with a rounded chance needs
-- the sentence in CONFIG.RoundedLine. Returns the text and whether it was rounded.
local function chanceText(chance)
	chance = tonumber(chance) or 0
	if chance <= 0 then
		return "0%", false
	end
	local decimals = math.max(0, 4 - math.floor(math.log(chance, 10)))
	local text = string.format("%." .. decimals .. "f", chance)
	local rounded = math.abs((tonumber(text) or 0) - chance) > 1e-9
	if string.find(text, ".", 1, true) then
		text = string.gsub(text, "0+$", "")
		text = string.gsub(text, "%.$", "")
	end
	return text .. "%", rounded
end

local function timeLeft(seconds)
	seconds = math.max(0, math.floor(seconds))
	local days = math.floor(seconds / 86400)
	local hours = math.floor((seconds % 86400) / 3600)
	local minutes = math.floor((seconds % 3600) / 60)
	if days > 0 then
		return days .. "d " .. hours .. "h"
	elseif hours > 0 then
		return hours .. "h " .. minutes .. "m"
	end
	return math.max(1, minutes) .. "m"
end

local function loadEntry(key)
	local ok, result = pcall(function()
		return liveStore:GetAsync(key, Core.FreshRead)
	end)
	if not ok then
		local text = tostring(result)
		if Core.IsStudioError(text) then
			warnOnce("studio", "DataStore is not available in Studio. Turn on: File -> Experience Settings -> Security -> Enable Studio Access to API Services, then Save.")
		else
			warn("[DiscordLive] Could not load " .. key .. ": " .. text)
		end
		return false, nil
	end
	return true, result
end

-- Text typed on Discord is filtered like any other text shown to players. Returns nil if it can't be filtered yet.
local function filterText(text, fromUserId)
	return Core.FilterText(text, fromUserId)
end

-- Multipliers as the players see them: currency names typed on Discord are filtered too
local function filteredMultipliers(multipliers)
	local result = {}
	if type(multipliers) ~= "table" then
		return result
	end
	for key, value in pairs(multipliers) do
		local name = tostring(key)
		if string.sub(name, 1, 9) == "currency:" and string.sub(name, 10) ~= "*" then
			local currency = filterText(string.sub(name, 10))
			if currency then
				result["currency:" .. currency] = value
			end
		else
			result[name] = value
		end
	end
	return result
end

-- A reward as the players see it (gift messages): currency and item names filtered
local function filteredReward(reward, userId)
	if type(reward) ~= "table" then
		return {}
	end
	return Core.RewardSummary(reward, { UserId = userId })
end

local function notify(player, payload)
	if remote and player and player.Parent then
		remote:FireClient(player, payload)
	end
end

-- ---------- Multiplier events ----------

local function eventActive(event)
	return type(event) == "table" and (tonumber(event.ends_at) or 0) > os.time()
end

local EXP_KEYS = { exp = true, xp = true, experience = true }
local usedMultipliers = {} -- what your code asks Live.GetMultiplier for (reported to the bot)
local usedMultiplierCount = 0

local function multiplierFor(kind)
	local key = normalize(kind)
	local total = 1
	for _, event in ipairs(Live.GetActiveEvents()) do
		if type(event.multipliers) == "table" then
			for name, value in pairs(event.multipliers) do
				local factor = tonumber(value) or 1
				local matches = false
				if name == "exp" then
					matches = EXP_KEYS[key] == true
				elseif name == "luck" then
					matches = key == "luck"
				elseif string.sub(name, 1, 9) == "currency:" then
					local currency = string.sub(name, 10)
					matches = key ~= "luck" and not EXP_KEYS[key] and (currency == "*" or normalize(currency) == key)
				end
				if matches and factor > 0 then
					total = total * factor
				end
			end
		end
	end
	return math.min(total, CONFIG.MaxMultiplier)
end

-- Product of the active multipliers for "Coins" (any currency name), "EXP" or "Luck"
function Live.GetMultiplier(kind)
	local key = normalize(kind)
	if key ~= "" and not usedMultipliers[key] and usedMultiplierCount < 30 then
		usedMultipliers[key] = string.sub(tostring(kind), 1, 50)
		usedMultiplierCount = usedMultiplierCount + 1
	end
	return multiplierFor(kind)
end

-- The same number without remembering the name (the ⚙️ Manager shows it; GetMultiplier would tell the bot that your
-- game uses that multiplier)
function Live.PeekMultiplier(kind)
	return multiplierFor(kind)
end

-- Names your code asked Live.GetMultiplier for (the Report module tells the bot which multipliers really work)
function Live.GetUsedMultipliers()
	local list = {}
	for _, name in pairs(usedMultipliers) do
		table.insert(list, name)
	end
	table.sort(list)
	return list
end

-- The events that haven't ended: those of every server (saved) and those of this server only (scope "server"),
-- also the ones still counting down to their start (starts_at in the future)
function Live.GetEvents()
	local list = {}
	for _, source in ipairs({ activeEvents, localEvents }) do
		for _, event in ipairs(source) do
			if eventActive(event) then
				table.insert(list, event)
			end
		end
	end
	return list
end

-- The events running now (their multipliers work): started and not ended. A new event starts 10 s after it was made,
-- so every player sees its countdown first.
function Live.GetActiveEvents()
	local list = {}
	local now = os.time()
	for _, event in ipairs(Live.GetEvents()) do
		if (tonumber(event.starts_at) or 0) <= now then
			table.insert(list, event)
		end
	end
	return list
end

-- EventsChanged fires when the list changes and again when a counting-down event starts
local startTimers = {}
local function eventsUpdated()
	eventsChanged:Fire(Live.GetActiveEvents())
	for _, event in ipairs(Live.GetEvents()) do
		local wait = (tonumber(event.starts_at) or 0) - os.time()
		local key = tostring(event.id) .. ":" .. tostring(event.starts_at)
		if wait > 0 and not startTimers[key] then
			startTimers[key] = true
			task.delay(wait, function()
				startTimers[key] = nil
				eventsChanged:Fire(Live.GetActiveEvents())
			end)
		end
	end
end

-- A start further away than the countdown comes from a PC whose clock is ahead of Roblox's: the event starts after
-- the countdown instead (the first time this server saw it, so it doesn't move on every refresh)
local COUNTDOWN = 10
local fixedStarts = {}
local function fixStarts(list)
	local now = os.time()
	for _, event in ipairs(list) do
		local starts = type(event) == "table" and tonumber(event.starts_at)
		if starts and starts > now + COUNTDOWN then
			local key = tostring(event.id) .. ":" .. tostring(starts)
			fixedStarts[key] = fixedStarts[key] or now + COUNTDOWN
			event.starts_at = fixedStarts[key]
		end
	end
end

local function sendEvents(target)
	if not remote then
		return
	end
	local list = {}
	for _, event in ipairs(Live.GetEvents()) do
		-- the animation and the start: the players' devices count down to the start, then show the animation
		table.insert(list, { id = event.id, name = filterText(event.name) or "", ends_at = event.ends_at,
			starts_at = tonumber(event.starts_at), animation = type(event.animation) == "string" and event.animation or nil,
			multipliers = filteredMultipliers(event.multipliers) })
	end
	local payload = { type = "events", events = list, server_time = os.time() }
	if target then
		remote:FireClient(target, payload)
	else
		remote:FireAllClients(payload)
	end
end

local function applyEvents(data)
	local list = {}
	if type(data) == "table" and type(data.events) == "table" then
		list = data.events
	end
	local signature = HttpService:JSONEncode(list)
	fixStarts(list)
	activeEvents = list
	if signature ~= eventsSignature then
		eventsSignature = signature
		eventsUpdated()
		sendEvents(nil)
	end
end

-- Returns ok and the time the bot (or the ⚙️ Manager) saved the events (updated_at)
function Live.RefreshEvents()
	local ok, data = loadEntry("Events")
	if not ok then
		return false
	end
	applyEvents(data)
	return true, type(data) == "table" and tonumber(data.updated_at) or nil
end

-- ---------- Eggs ----------

local function eggOpen(egg)
	local endsAt = tonumber(egg.ends_at) or 0
	return endsAt == 0 or endsAt > os.time()
end

local function eggById(id)
	for _, egg in ipairs(activeEggs) do
		if tostring(egg.id) == tostring(id) then
			return egg
		end
	end
	return nil
end

local function parseColor(text)
	if type(text) ~= "string" then
		return nil
	end
	local r, g, b = string.match(text, "^#?(%x%x)(%x%x)(%x%x)$")
	if not r then
		return nil
	end
	return Color3.fromRGB(tonumber(r, 16), tonumber(g, 16), tonumber(b, 16))
end

local function spotName(spot)
	local name = spot:GetAttribute("Spot")
	if type(name) == "string" and name ~= "" then
		return name
	end
	return spot.Name
end

local function getSpots()
	local spots = {}
	for _, spot in ipairs(CollectionService:GetTagged(CONFIG.EggSpotTag)) do
		if spot:IsDescendantOf(Workspace) and (spot:IsA("BasePart") or spot:IsA("Model")) then
			table.insert(spots, spot)
		end
	end
	table.sort(spots, function(a, b)
		return spotName(a) < spotName(b)
	end)
	return spots
end

-- The middle of a spot's top in world space, standing straight: a Cylinder turned 90° to stand as a round pedestal,
-- or a part turned upside down, still gets the egg on its highest side and upright. The egg keeps only the spot's turn
-- around the vertical axis (which way it faces).
local atan2 = math.atan2 or math.atan
local function spotTop(spot)
	local cframe, size
	if spot:IsA("BasePart") then
		cframe, size = spot.CFrame, spot.Size
	else
		cframe, size = spot:GetBoundingBox()
	end
	local halfHeight = (math.abs(cframe.RightVector.Y) * size.X + math.abs(cframe.UpVector.Y) * size.Y
		+ math.abs(cframe.LookVector.Y) * size.Z) / 2
	local look = cframe.LookVector
	local yaw = (math.abs(look.X) + math.abs(look.Z) > 0.001) and atan2(-look.X, -look.Z) or 0
	local position = cframe.Position
	return CFrame.new(position.X, position.Y + halfHeight, position.Z) * CFrame.Angles(0, yaw, 0)
end

-- A model in the egg models folder (only a Model or a Part, like the ones the Report module tells the bot about)
local function eggTemplate(folder, name)
	local child = folder:FindFirstChild(name)
	if child and (child:IsA("Model") or child:IsA("BasePart")) then
		return child
	end
	return nil
end

local function makeEggModel(egg)
	local folder = ReplicatedStorage:FindFirstChild(CONFIG.EggTemplatesFolder)
	local template = nil
	if folder then
		local wanted = (type(egg.template) == "string" and egg.template ~= "") and egg.template or "Default"
		template = eggTemplate(folder, wanted) or eggTemplate(folder, "Default")
		if not template and wanted ~= "Default" then
			warnOnce("template|" .. wanted, "Egg template '" .. wanted .. "' not found in ReplicatedStorage." .. CONFIG.EggTemplatesFolder .. ". A simple egg is used.")
		end
	end
	local model
	if template and (template:IsA("Model") or template:IsA("BasePart")) then
		local copy = template:Clone()
		if copy:IsA("BasePart") then
			model = Instance.new("Model")
			copy.Parent = model
			model.PrimaryPart = copy
		else
			model = copy
		end
	else
		model = Instance.new("Model")
		local part = Instance.new("Part")
		part.Name = "Egg"
		part.Size = Vector3.new(4, 4, 4)
		part.Material = Enum.Material.SmoothPlastic
		part.Color = parseColor(egg.color) or Color3.fromRGB(245, 245, 245)
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Scale = Vector3.new(1, 1.3, 1)
		mesh.Parent = part
		part:SetAttribute("Rainbow", egg.color == "rainbow")
		part.Parent = model
		model.PrimaryPart = part
	end
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
		end
	end
	if not model.PrimaryPart then
		model.PrimaryPart = model:FindFirstChildWhichIsA("BasePart", true)
	end
	return model
end

-- ---------- Look of the stand (the same style as the code window) ----------
local INK = Color3.fromRGB(27, 29, 41)
local GOLD = Color3.fromRGB(255, 200, 61)
local GOLD_EDGE = Color3.fromRGB(222, 178, 82) -- the thin border of the sign
local TITLE_FONT = Font.new("rbxasset://fonts/families/FredokaOne.json")
-- Fredoka One has no Polish letters (ą, ę, ń...): a name with such letters uses Nunito, which has them all
local BODY_FONT = Font.new("rbxasset://fonts/families/Nunito.json", Enum.FontWeight.Heavy)
local function fontFor(text)
	return string.find(text, "[\196-\197]") and BODY_FONT or TITLE_FONT
end

-- The stand is sized in studs, so it gets smaller with distance: its texts fill their box and scale with it (up to
-- textSize pixels: big and readable up close, never bigger than their box)
-- Capital letters also for Polish and Spanish letters (string.upper changes only a-z: "Tęczowe" would be "TęCZOWE")
local CAPITALS = { ["ą"] = "Ą", ["ć"] = "Ć", ["ę"] = "Ę", ["ł"] = "Ł", ["ń"] = "Ń", ["ó"] = "Ó", ["ś"] = "Ś", ["ź"] = "Ź", ["ż"] = "Ż",
	["á"] = "Á", ["é"] = "É", ["í"] = "Í", ["ú"] = "Ú", ["ü"] = "Ü", ["ñ"] = "Ñ" }
local function upper(text)
	return (string.gsub(string.upper(tostring(text)), "[\195\196\197][\128-\191]", function(letter)
		return CAPITALS[letter] or letter
	end))
end

local function label(parent, name, size, position, textSize, font)
	local text = Instance.new("TextLabel")
	text.Name = name
	text.BackgroundTransparency = 1
	text.Size = size
	text.Position = position
	text.FontFace = font or BODY_FONT
	text.TextScaled = true
	local largest = Instance.new("UITextSizeConstraint")
	largest.MaxTextSize = textSize
	largest.Parent = text
	text.TextColor3 = Color3.fromRGB(255, 255, 255)
	text.TextStrokeColor3 = INK
	text.TextStrokeTransparency = 0
	text.TextWrapped = true
	text.Parent = parent
	return text
end

-- A dark rounded box behind a label (price, chances, timer); roundness: a part of the box's height, so it scales too
local function darkBox(text, roundness)
	text.BackgroundColor3 = INK
	text.BackgroundTransparency = 0.12
	text.TextStrokeTransparency = 1
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(roundness, 0)
	corner.Parent = text
end

local function pedestalPart(name, parent, size, cframe, color, material)
	local part = Instance.new("Part")
	part.Name = name
	part.Shape = Enum.PartType.Cylinder
	part.Size = size
	part.CFrame = cframe * CFrame.Angles(0, 0, math.pi / 2) -- a cylinder lies on its side: stand it up
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

-- The round pedestal under an egg: a purple base, a glowing gold ring, a soft light and a few sparkles. Off with
-- Live.Config.Pedestal = false (in your own script) when your egg spots already are pedestals. Returns the model and
-- its height in studs.
local function makePedestal(top, eggSize, glow)
	local width = math.clamp(math.max(eggSize.X, eggSize.Z) * 1.6, 5, 14)
	local pedestal = Instance.new("Model")
	pedestal.Name = "DiscordPedestal"
	local base = pedestalPart("Base", pedestal, Vector3.new(1.2, width, width), top * CFrame.new(0, 0.6, 0), Color3.fromRGB(106, 80, 240))
	base.CanCollide = true
	pedestalPart("Rim", pedestal, Vector3.new(0.3, width * 0.9, width * 0.9), top * CFrame.new(0, 1.35, 0), Color3.fromRGB(157, 137, 255))
	local ring = pedestalPart("Ring", pedestal, Vector3.new(0.1, width * 0.72, width * 0.72), top * CFrame.new(0, 1.53, 0), GOLD, Enum.Material.Neon)
	pedestalPart("RingInside", pedestal, Vector3.new(0.12, width * 0.6, width * 0.6), top * CFrame.new(0, 1.54, 0), Color3.fromRGB(157, 137, 255))
	pedestal.PrimaryPart = base

	local light = Instance.new("PointLight")
	light.Color = glow
	light.Brightness = 1.2
	light.Range = 12
	light.Parent = ring
	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Name = "Sparkles"
	sparkles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkles.Color = ColorSequence.new(GOLD)
	sparkles.LightEmission = 1
	sparkles.Size = NumberSequence.new(0.35, 0)
	sparkles.Lifetime = NumberRange.new(1.2, 2)
	sparkles.Speed = NumberRange.new(1.5, 3)
	sparkles.SpreadAngle = Vector2.new(25, 25)
	sparkles.Rate = 4
	sparkles.EmissionDirection = Enum.NormalId.Top
	sparkles.Parent = ring
	return pedestal, 1.6
end

-- The chance of each pet (in %) that a player really gets now: a luck event multiplies the weight of the rare pets.
-- The egg shows these and rolls with these, with the same luck (shownLuck): Roblox requires the odds of paid random
-- items to be shown accurately before the purchase.
local function currentChances(egg, luck)
	luck = luck or shownLuck
	local weights, total = {}, 0
	for i, pet in ipairs(egg.pets) do
		local weight = math.max(0, tonumber(pet.chance) or 0)
		if weight > 0 and weight <= CONFIG.RareChance then
			weight = weight * luck
		end
		weights[i] = weight
		total = total + weight
	end
	-- chances that already add up to 100 (as the bot saves them) stay exactly as written
	local scale = math.abs(total - 100) < 0.01 and 1 or (total > 0 and 100 / total or 0)
	local chances = {}
	for i, weight in ipairs(weights) do
		chances[i] = weight * scale
	end
	return chances, total
end

-- Every pet with its chance: none may be hidden (Roblox: all odds shown before the purchase); the stand grows for long
-- lists. Names are filtered first (that may wait) and the chances read after, so the sign always has the current luck.
-- Returns { pets = { {name, chance, was, tier} sorted by chance }, luckLine = text or nil, rounded = bool }:
-- was = the chance without luck (only where luck changes it), tier 1..4 = grey, green, blue, gold by how rare it is.
local function petsData(egg)
	local names = {}
	for i, pet in ipairs(egg.pets) do
		names[i] = filterText(pet.name)
		if names[i] == nil then
			names[i] = "?"
			pendingFilter = true -- filtered again when a player joins
		end
	end
	local pets = {}
	local chances = currentChances(egg)
	local plain = currentChances(egg, 1)
	local rare, common = false, false
	for i, pet in ipairs(egg.pets) do
		local base = tonumber(pet.chance) or 0
		if base > 0 and base <= CONFIG.RareChance then
			rare = true
		elseif base > 0 then
			common = true
		end
	end
	local luckShown = shownLuck > 1 and rare and common -- only where luck really changes the chances
	for i, pet in ipairs(egg.pets) do
		local base = tonumber(pet.chance) or 0
		local tier = 1
		if base > 0 and base <= CONFIG.RareChance then
			tier = 4
		elseif plain[i] <= 20 then
			tier = 3
		elseif plain[i] <= 35 then
			tier = 2
		end
		local was = nil
		if luckShown and math.abs(plain[i] - chances[i]) > 1e-6 then
			was = plain[i]
		end
		table.insert(pets, { name = names[i], chance = chances[i], was = was, tier = tier })
	end
	table.sort(pets, function(a, b)
		return a.chance > b.chance
	end)
	local luckLine = nil
	if luckShown then
		luckLine = string.format(CONFIG.LuckLine, string.format("%g", math.floor(shownLuck * 100 + 0.5) / 100))
	end
	local anyRounded = false
	for _, pet in ipairs(pets) do
		local _, rounded = chanceText(pet.chance)
		anyRounded = anyRounded or rounded
	end
	return { pets = pets, luckLine = luckLine, rounded = anyRounded }
end

local openEgg -- defined below

local function buildStand(egg, spot)
	local model = makeEggModel(egg)
	local primary = model.PrimaryPart
	if not primary then
		model:Destroy()
		warnOnce("template-empty|" .. tostring(egg.template), "Egg template has no parts.")
		return
	end
	model.Name = "DiscordEgg_" .. tostring(egg.id)
	model:SetAttribute("EggId", egg.id)
	local top = spotTop(spot)
	model:PivotTo(top)
	local boxCFrame, boxSize = model:GetBoundingBox()
	local pedestal, pedestalHeight = nil, 0
	if CONFIG.Pedestal then
		local glow = parseColor(egg.color) or GOLD
		-- standing straight even on a turned or tilted spot part
		pedestal, pedestalHeight = makePedestal(CFrame.new(top.Position.X, top.Position.Y, top.Position.Z), boxSize, glow)
	end
	local lift = top.Position.Y + pedestalHeight - (boxCFrame.Position.Y - boxSize.Y / 2) + 0.05
	model:PivotTo(model:GetPivot() + Vector3.new(0, lift, 0))
	if pedestal then
		pedestal.Parent = model -- after placing the egg, so the egg's size above did not count the pedestal
	end
	-- The players' devices let the egg float up and down and turn slowly around its middle (DiscordLiveClient); the
	-- server keeps it still. Streamed as a whole, so a player's device never gets half an egg.
	if CONFIG.EggAnimation then
		model:SetAttribute("DiscordFloat", Vector3.new(top.Position.X, boxCFrame.Position.Y + lift, top.Position.Z))
	end
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic

	local displayName = filterText(egg.name)
	if displayName == nil then
		displayName = "Egg"
		pendingFilter = true
	end
	local currencyName = filterText(egg.currency)
	if currencyName == nil then
		currencyName = ""
		pendingFilter = true
	end

	-- The sign (navy panel, thin gold border, gold title, a crown on top): in studs from the top of the sign. The pets are
	-- one dark pill each, 4 at least; the sign grows by a row's height for each pet more, so every chance stays readable.
	-- Under the pets a line for the rounding note and the timer of an egg that ends.
	local data = petsData(egg)
	local WIDTH = 8
	local ROW, STRIDE, FIRST = 0.58, 0.66, 3.55
	local rowsEnd = FIRST + math.max(4, #data.pets) * STRIDE
	-- room for the rounding note always (luck may make a chance rounded later), for the timer only on an egg that ends
	local timed = (tonumber(egg.ends_at) or 0) > 0
	local height = rowsEnd + 0.6 + (timed and 0.9 or 0) + 0.15
	local gui = Instance.new("BillboardGui")
	gui.Name = "EggInfo"
	gui.Size = UDim2.fromScale(WIDTH, height)
	-- Above the egg. With a pedestal it hangs on a point of the pedestal, so it stays still while the egg floats: a
	-- point placed straight (the pedestal's cylinder lies turned, and an offset from it would turn with it)
	local above = boxSize.Y / 2 + height / 2 + 1.1 -- the sign's bottom stays above the egg (it floats a little)
	if pedestal then
		local point = Instance.new("Attachment")
		point.Name = "InfoPoint"
		point.Parent = pedestal.PrimaryPart
		point.WorldCFrame = CFrame.new(top.Position.X, boxCFrame.Position.Y + lift + above, top.Position.Z)
		gui.Adornee = point
	else
		gui.StudsOffsetWorldSpace = Vector3.new(0, above, 0)
		gui.Adornee = primary
	end
	gui.MaxDistance = 70
	gui.Parent = primary
	-- a box in studs: x, y from the sign's top left corner, w, h its size
	local function put(object, x, y, w, h)
		object.Position = UDim2.fromScale(x / WIDTH, y / height)
		object.Size = UDim2.fromScale(w / WIDTH, h / height)
		return object
	end
	local function frame(parent, name, x, y, w, h, color)
		local item = Instance.new("Frame")
		item.Name = name
		item.BackgroundColor3 = color or Color3.fromRGB(255, 255, 255)
		item.BorderSizePixel = 0
		item.Parent = parent
		return put(item, x, y, w, h)
	end
	local function round(item, part)
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(part, 0)
		corner.Parent = item
	end
	local function edge(item, color, thickness)
		local stroke = Instance.new("UIStroke")
		stroke.Color = color
		stroke.Thickness = thickness
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Parent = item
		return stroke
	end
	local function shade(item, top, bottom)
		local gradient = Instance.new("UIGradient")
		gradient.Color = ColorSequence.new(top, bottom)
		gradient.Rotation = 90
		gradient.Parent = item
		return gradient
	end
	local function goldShade(item)
		return shade(item, Color3.fromRGB(255, 232, 140), Color3.fromRGB(214, 138, 22))
	end

	-- the navy panel starts a little below the top: the crown sits on its edge
	local panel = frame(gui, "Panel", 0, 0.8, WIDTH, height - 0.8)
	round(panel, 0.07)
	shade(panel, Color3.fromRGB(36, 44, 92), Color3.fromRGB(20, 26, 60))
	edge(panel, GOLD_EDGE, 2)

	-- the crown: a gold band, three spikes with balls and a violet gem
	local crown = frame(gui, "Crown", 3.05, 0, 1.9, 1.1)
	crown.BackgroundTransparency = 1
	local function crownPart(x, y, w, h, turn, round_, fill)
		local part = Instance.new("Frame")
		part.AnchorPoint = Vector2.new(0.5, 0.5)
		part.Position = UDim2.fromScale(x / 1.9, y / 1.1)
		part.Size = UDim2.fromScale(w / 1.9, h / 1.1)
		part.Rotation = turn
		part.BackgroundColor3 = fill or Color3.fromRGB(255, 255, 255)
		part.BorderSizePixel = 0
		part.Parent = crown
		if round_ then
			round(part, 0.5)
		end
		return part
	end
	for _, spike in ipairs({ { 0.45, 0.52, 0.5 }, { 1.45, 0.52, 0.5 }, { 0.95, 0.42, 0.66 } }) do
		local part = crownPart(spike[1], spike[2], spike[3], spike[3] * (1.9 / 1.9), 45, false)
		goldShade(part)
		edge(part, Color3.fromRGB(110, 64, 6), 1)
	end
	for _, ball in ipairs({ { 0.2, 0.34 }, { 0.95, 0.1 }, { 1.7, 0.34 } }) do
		local part = crownPart(ball[1], ball[2], 0.17, 0.17, 0, true, Color3.fromRGB(255, 226, 120))
		edge(part, Color3.fromRGB(110, 64, 6), 1)
	end
	local band = crownPart(0.95, 0.92, 1.6, 0.3, 0, false)
	round(band, 0.5)
	goldShade(band)
	edge(band, Color3.fromRGB(110, 64, 6), 1)
	local gem = crownPart(0.95, 0.6, 0.28, 0.28, 45, false, Color3.fromRGB(150, 80, 240))
	edge(gem, Color3.fromRGB(60, 20, 110), 1)

	local title = label(gui, "Title", UDim2.fromScale(1, 0), UDim2.fromScale(0, 0), 60, fontFor(displayName))
	put(title, 0.3, 1.1, WIDTH - 0.6, 1.2)
	title.Text = upper(displayName)
	title.TextColor3 = Color3.fromRGB(255, 255, 255)
	title.TextStrokeColor3 = Color3.fromRGB(70, 40, 6)
	title.TextStrokeTransparency = 0.3
	goldShade(title)

	-- the price: a gold pill with a coin, or a blue one with a gem (a currency called Gems or Gem)
	local gems = string.find(string.lower(currencyName), "gem", 1, true) ~= nil
	local priceBox = frame(gui, "PriceBox", 2.15, 2.45, 3.7, 0.86)
	round(priceBox, 0.5)
	if gems then
		shade(priceBox, Color3.fromRGB(110, 190, 255), Color3.fromRGB(34, 98, 214))
		edge(priceBox, Color3.fromRGB(10, 30, 80), 2)
	else
		shade(priceBox, Color3.fromRGB(255, 226, 120), Color3.fromRGB(226, 148, 24))
		edge(priceBox, Color3.fromRGB(80, 46, 6), 2)
	end
	local icon = frame(gui, "PriceIcon", 2.5, 2.6, 0.55, 0.55)
	icon.BackgroundTransparency = 1
	if gems then
		icon.Rotation = 45
		icon.Size = UDim2.fromScale(0.4 / WIDTH, 0.4 / height)
		icon.Position = UDim2.fromScale(2.62 / WIDTH, 2.68 / height)
		edge(icon, Color3.fromRGB(255, 255, 255), 2.5)
	else
		icon.BackgroundTransparency = 0
		goldShade(icon)
		round(icon, 0.5)
		edge(icon, Color3.fromRGB(110, 64, 6), 2)
	end
	local price = label(gui, "Price", UDim2.fromScale(1, 0), UDim2.fromScale(0, 0), 44, fontFor(formatNumber(egg.price) .. " " .. currencyName))
	put(price, 3.15, 2.52, 2.55, 0.72)
	price.TextStrokeTransparency = 1
	price.TextColor3 = gems and Color3.fromRGB(8, 24, 66) or Color3.fromRGB(70, 40, 6)
	price.Text = formatNumber(egg.price) .. " " .. currencyName

	-- the luck tag: tilted, green, over the corner of the title
	local luckTag = label(gui, "LuckTag", UDim2.fromScale(1, 0), UDim2.fromScale(0, 0), 30, BODY_FONT)
	put(luckTag, 5.35, 0.95, 2.45, 0.55)
	luckTag.Rotation = -8
	luckTag.BackgroundColor3 = Color3.fromRGB(70, 200, 100)
	luckTag.BackgroundTransparency = 0
	luckTag.TextStrokeTransparency = 1
	luckTag.TextColor3 = Color3.fromRGB(12, 66, 28)
	round(luckTag, 0.3)
	edge(luckTag, Color3.fromRGB(16, 98, 44), 2)
	local tagPadding = Instance.new("UIPadding")
	tagPadding.PaddingTop = UDim.new(0.1, 0)
	tagPadding.PaddingBottom = UDim.new(0.1, 0)
	tagPadding.PaddingLeft = UDim.new(0.05, 0)
	tagPadding.PaddingRight = UDim.new(0.05, 0)
	tagPadding.Parent = luckTag

	-- the rows: the pet with a dot, its name and its chance (the rarer, the warmer the colors)
	local pets = frame(gui, "Pets", 0, 0, WIDTH, height)
	pets.BackgroundTransparency = 1
	local TIERS = {
		{ dot = Color3.fromRGB(205, 208, 222), text = Color3.fromRGB(215, 218, 232) },
		{ dot = Color3.fromRGB(96, 224, 128), text = Color3.fromRGB(96, 224, 128) },
		{ dot = Color3.fromRGB(88, 178, 255), text = Color3.fromRGB(88, 178, 255) },
		{ dot = Color3.fromRGB(255, 196, 64), text = Color3.fromRGB(255, 200, 70) },
	}
	local function fillRows(info)
		for _, child in ipairs(pets:GetChildren()) do
			child:Destroy()
		end
		for i, pet in ipairs(info.pets) do
			local y = FIRST + (i - 1) * STRIDE
			local tier = TIERS[pet.tier]
			local row = frame(pets, "Row", 0.45, y, WIDTH - 0.9, ROW)
			round(row, 0.5)
			if pet.tier == 4 then
				shade(row, Color3.fromRGB(104, 66, 14), Color3.fromRGB(54, 32, 6))
				edge(row, GOLD_EDGE, 2)
			else
				shade(row, Color3.fromRGB(34, 42, 86), Color3.fromRGB(16, 20, 46))
				edge(row, Color3.fromRGB(70, 82, 132), 1.5)
			end
			local dot = Instance.new("Frame")
			dot.Name = "Dot"
			dot.AnchorPoint = Vector2.new(0.5, 0.5)
			dot.Position = UDim2.fromScale(0.34 / (WIDTH - 0.9), 0.5)
			dot.Size = UDim2.fromScale(0.26 / (WIDTH - 0.9), 0.26 / ROW)
			dot.BackgroundColor3 = tier.dot
			dot.BorderSizePixel = 0
			dot.Parent = row
			round(dot, 0.5)
			local name = label(row, "Name", UDim2.fromScale(0.52, 0.8), UDim2.fromScale(0.1, 0.1), 34, fontFor(pet.name))
			name.TextXAlignment = Enum.TextXAlignment.Left
			name.Text = pet.name
			name.TextStrokeTransparency = 1
			local percent = label(row, "Percent", UDim2.fromScale(0.26, 0.8), UDim2.fromScale(0.72, 0.1), 34, BODY_FONT)
			percent.TextXAlignment = Enum.TextXAlignment.Right
			percent.Text = (chanceText(pet.chance))
			percent.TextColor3 = tier.text
			percent.TextStrokeTransparency = 1
			if pet.was then -- luck changed it: the old chance struck through next to the new one
				local was = label(row, "Was", UDim2.fromScale(0.2, 0.7), UDim2.fromScale(0.5, 0.15), 24, BODY_FONT)
				was.TextXAlignment = Enum.TextXAlignment.Right
				was.RichText = true
				was.Text = "<s>" .. (chanceText(pet.was)) .. "</s>"
				was.TextColor3 = Color3.fromRGB(150, 156, 180)
				was.TextStrokeTransparency = 1
			end
		end
	end
	local note = label(gui, "RoundedNote", UDim2.fromScale(1, 0), UDim2.fromScale(0, 0), 16)
	put(note, 0.2, rowsEnd + 0.04, WIDTH - 0.4, 0.5)
	note.TextColor3 = Color3.fromRGB(225, 225, 235)
	note.Text = CONFIG.RoundedLine
	local function refresh()
		local info = petsData(egg)
		fillRows(info)
		note.Visible = info.rounded
		luckTag.Visible = info.luckLine ~= nil
		luckTag.Text = info.luckLine or ""
	end
	refresh()
	local timer = label(gui, "Timer", UDim2.fromScale(0.62, 0), UDim2.fromScale(0, 0), 36, BODY_FONT)
	put(timer, 1.52, rowsEnd + 0.6, 4.96, 0.8)
	timer.TextColor3 = GOLD
	darkBox(timer, 0.5)
	local timerPadding = Instance.new("UIPadding")
	timerPadding.PaddingTop = UDim.new(0.14, 0) -- the text never touches the pill's edge
	timerPadding.PaddingBottom = UDim.new(0.14, 0)
	timerPadding.Parent = timer
	timer.Visible = false -- shown by updateTimers for an egg that ends

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = CONFIG.PromptText
	prompt.ObjectText = displayName .. " - " .. formatNumber(egg.price) .. " " .. currencyName
	prompt.HoldDuration = 0.25
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = primary
	prompt.Triggered:Connect(function(player)
		openEgg(player, egg.id)
	end)

	model.Parent = standsFolder
	return { model = model, egg = egg, timer = timer, pets = pets, refresh = refresh }
end

local function updateTimers()
	local now = os.time()
	local expired = false
	for _, stand in pairs(rendered) do
		local endsAt = tonumber(stand.egg.ends_at) or 0
		if endsAt > 0 then
			if endsAt <= now then
				expired = true
			elseif stand.timer and stand.timer.Parent then
				stand.timer.Text = "⏳ " .. timeLeft(endsAt - now)
				stand.timer.Visible = true
			end
		end
	end
	return expired
end

local function renderEggs()
	renderQueued = false
	renderGeneration = renderGeneration + 1
	local mine = renderGeneration
	shownLuck = multiplierFor("Luck")
	if not standsFolder or not standsFolder.Parent then
		standsFolder = Workspace:FindFirstChild("DiscordEggStands")
		if not standsFolder then
			standsFolder = Instance.new("Folder")
			standsFolder.Name = "DiscordEggStands"
			standsFolder.Parent = Workspace
		end
	end
	for _, stand in pairs(rendered) do
		stand.model:Destroy()
	end
	rendered = {}
	pendingFilter = false

	local open = {}
	for _, egg in ipairs(activeEggs) do
		if type(egg) == "table" and eggOpen(egg) and type(egg.pets) == "table" and #egg.pets > 0 then
			table.insert(open, egg)
		end
	end
	local spots = getSpots()
	if #open > 0 and #spots == 0 then
		warnOnce("nospots", "Eggs were added by the bot, but the game has no egg spots. Give a part the tag '" .. CONFIG.EggSpotTag .. "' where an egg should stand.")
		return
	end
	local used, placed = {}, {}
	-- 1) eggs that asked for a named spot
	for _, egg in ipairs(open) do
		if type(egg.spot) == "string" and egg.spot ~= "" then
			for _, spot in ipairs(spots) do
				if not used[spot] and normalize(spotName(spot)) == normalize(egg.spot) then
					used[spot] = true
					placed[egg] = spot
					break
				end
			end
			if not placed[egg] then
				warnOnce("spot|" .. egg.spot, "Egg spot '" .. egg.spot .. "' not found (or already taken); the egg goes to a free spot.")
			end
		end
	end
	-- 2) the rest stay where they stood, if that spot is still there and free (each server remembers its own eggs,
	--    so after changes two servers may show an egg on different spots; the bot's "spot" option fixes the spot)
	local present = {}
	for _, spot in ipairs(spots) do
		present[spot] = true
	end
	for _, egg in ipairs(open) do
		local spot = egg.id ~= nil and lastSpots[egg.id] or nil
		if not placed[egg] and spot and present[spot] and not used[spot] then
			used[spot] = true
			placed[egg] = spot
		end
	end
	-- 3) and the others on free spots, in order
	for _, egg in ipairs(open) do
		if not placed[egg] then
			for _, spot in ipairs(spots) do
				if not used[spot] then
					used[spot] = true
					placed[egg] = spot
					break
				end
			end
			if not placed[egg] then
				warnOnce("full|" .. tostring(egg.id), "Not enough egg spots for '" .. tostring(egg.name) .. "'. Add another part with the tag '" .. CONFIG.EggSpotTag .. "'.")
			end
		end
	end
	lastSpots = {}
	for egg, spot in pairs(placed) do
		if egg.id ~= nil then
			lastSpots[egg.id] = spot
		end
	end
	for _, egg in ipairs(open) do
		if placed[egg] then
			local ok, stand = pcall(buildStand, egg, placed[egg])
			if mine ~= renderGeneration then
				-- building waits for Roblox's text filter; a newer drawing started meanwhile and draws every stand
				-- itself. This one removes what it just built and stops, so no stand with old chances stays behind.
				if ok and stand then
					stand.model:Destroy()
				end
				return
			end
			if not ok then
				warn("[DiscordLive] Could not build the stand for '" .. tostring(egg.name) .. "': " .. tostring(stand))
			elseif stand then
				rendered[egg.id] = stand
			end
		end
	end
	updateTimers()
end

local function queueRender()
	if not renderQueued then
		renderQueued = true
		task.delay(0.5, renderEggs)
	end
end

local function applyEggs(data)
	local list = {}
	if type(data) == "table" and type(data.eggs) == "table" then
		list = data.eggs
	end
	local signature = HttpService:JSONEncode(list)
	if signature ~= eggsSignature then
		-- replaced only when something changed: openEgg compares the egg with the one its stand shows
		activeEggs = list
		eggsSignature = signature
		queueRender()
	end
end

-- Returns ok and the time the bot (or the ⚙️ Manager) saved the eggs (updated_at)
function Live.RefreshEggs()
	local ok, data = loadEntry("Eggs")
	if not ok then
		return false
	end
	applyEggs(data)
	return true, type(data) == "table" and tonumber(data.updated_at) or nil
end

-- ---------- Changes made by the game itself (the ⚙️ Manager, see the Control module) ----------

local LISTS = { Events = "events", Eggs = "eggs" }

-- An entry ended: an event after its time, an egg after its end (0 = no end)
local function ended(key, item, now)
	local ends = type(item) == "table" and tonumber(item.ends_at) or 0
	if key == "Events" then
		return ends <= now
	end
	return ends > 0 and ends <= now
end

-- Changes the saved events (key "Events") or eggs ("Eggs"): change(data) gets the entry (data.events or data.eggs,
-- a list) inside one UpdateAsync and returns true to save it; it may run more than once. Ended ones are left out.
-- Returns ok and the saved entry (nil when nothing was saved), or false and the error. Every server shows it at once.
local function change(key, edit)
	local field = LISTS[key]
	local saved = nil
	local ok, err = pcall(function()
		liveStore:UpdateAsync(key, function(old)
			saved = nil
			local data = type(old) == "table" and old or {}
			local list = {}
			local now = os.time()
			for _, item in ipairs(type(data[field]) == "table" and data[field] or {}) do
				if type(item) == "table" and item.id ~= nil and not ended(key, item, now) then
					table.insert(list, item)
				end
			end
			data[field] = list
			if not edit(data) then
				return nil
			end
			data.version = math.max(2, tonumber(data.version) or 0)
			data.updated_at = Core.SaveTime(data.updated_at)
			saved = data
			return data
		end)
	end)
	if not ok then
		return false, tostring(err)
	end
	if saved then
		if key == "Events" then
			applyEvents(saved)
		else
			applyEggs(saved)
		end
		Core.Publish(CONFIG.MessagingTopic, { type = field, at = saved.updated_at })
	end
	return true, saved
end

-- An event of this server only (the ⚙️ Manager's "this server"): it runs until its end or until this server stops,
-- other servers and the bot never see it. Returns the event with its id ("s1", "s2"...).
function Live.AddLocalEvent(event)
	localNumber = localNumber + 1
	event.id = "s" .. localNumber
	event.scope = "server"
	local kept = {}
	for _, old in ipairs(localEvents) do
		if eventActive(old) then
			table.insert(kept, old)
		end
	end
	table.insert(kept, event)
	localEvents = kept
	eventsUpdated()
	sendEvents(nil)
	return event
end

-- Stops an event of this server only; returns it (nil when there is none with this id)
function Live.RemoveLocalEvent(id)
	for i, event in ipairs(localEvents) do
		if tostring(event.id) == tostring(id) then
			table.remove(localEvents, i)
			eventsUpdated()
			sendEvents(nil)
			return event
		end
	end
	return nil
end

function Live.ChangeEvents(edit)
	return change("Events", edit)
end

function Live.ChangeEggs(edit)
	return change("Eggs", edit)
end

-- A new id for an event or egg made in the game ("g1", "g2"...; the bot's own ones are numbers). Call it inside
-- change(): the counter is saved with the entry.
function Live.NewId(data)
	local number = math.max(math.floor(tonumber(data.next_id) or 1), 1)
	-- never an id the entry already has (e.g. the entry was made again without its counter)
	for _, field in pairs(LISTS) do
		for _, item in ipairs(type(data[field]) == "table" and data[field] or {}) do
			local used = type(item) == "table" and tonumber(string.match(tostring(item.id), "^g(%d+)$"))
			if used and used >= number then
				number = used + 1
			end
		end
	end
	data.next_id = number + 1
	return "g" .. number
end

function Live.GetEggs()
	return activeEggs
end

-- Returns the pet and its chance (%) as the egg shows it
local function rollPet(egg)
	local chances, total = currentChances(egg)
	if total <= 0 then
		return nil
	end
	local roll = random:NextNumber() * 100
	for i, pet in ipairs(egg.pets) do
		roll = roll - chances[i]
		if roll <= 0 and chances[i] > 0 then
			return pet, chances[i]
		end
	end
	for i = #egg.pets, 1, -1 do
		if chances[i] > 0 then
			return egg.pets[i], chances[i]
		end
	end
	return nil
end

-- A luck event started or ended: the chances on the eggs (and the rolls) follow at once, without rebuilding the stands
-- Returns true when the luck changed. The labels change in their own thread (filtering pet names may wait).
local function updateLuck()
	local luck = multiplierFor("Luck")
	if luck == shownLuck then
		return false
	end
	shownLuck = luck
	task.spawn(function()
		for _, stand in pairs(rendered) do
			if stand.pets and stand.pets.Parent and stand.refresh then
				stand.refresh()
			end
		end
	end)
	return true
end
Live.UpdateLuck = updateLuck

-- The chances of an egg as players get them now, for your own egg shop UI: { { name = "Cat", chance = 60 }, ... }
function Live.GetChances(eggId)
	local egg = eggById(eggId)
	if not egg or type(egg.pets) ~= "table" then
		return {}
	end
	local list = {}
	for i, chance in ipairs((currentChances(egg))) do
		table.insert(list, { name = egg.pets[i].name, chance = chance })
	end
	return list
end

-- Roblox doesn't let some players buy paid random items (PolicyService ArePaidRandomItemsRestricted). Asked once per
-- player (also in the background when they join). Returns true, false, or nil when the check failed (the egg is not
-- opened then and the next try asks again; in Studio a failed check lets the egg open, so testing isn't blocked).
local function checkPaidRandomItems(player)
	if randomItemsAllowed[player] ~= nil then
		return randomItemsAllowed[player]
	end
	local ok, info = pcall(function()
		return PolicyService:GetPolicyInfoForPlayerAsync(player)
	end)
	if not ok or type(info) ~= "table" then
		warnOnce("policy", "Could not check PolicyService for paid random items (" .. tostring(info) .. "). Eggs stay closed "
			.. "for that player until the check works. If no egg currency in your game can be bought with Robux, set "
			.. "Live.Config.PaidRandomItems = false in your own script."
			.. (RunService:IsStudio() and " (In Studio a failed check doesn't block eggs, so you can test.)" or ""))
		return nil
	end
	if player.Parent then -- not for a player who left while Roblox was answering
		randomItemsAllowed[player] = info.ArePaidRandomItemsRestricted ~= true
	end
	return info.ArePaidRandomItemsRestricted ~= true
end

local function mayOpenEggs(player)
	if not CONFIG.PaidRandomItems then
		return true
	end
	local allowed = checkPaidRandomItems(player)
	if allowed == nil and RunService:IsStudio() then
		return true
	end
	return allowed
end

openEgg = function(player, eggId)
	local clock = os.clock()
	if lastOpen[player] and clock - lastOpen[player] < CONFIG.OpenCooldownSeconds then
		return
	end
	lastOpen[player] = clock
	local egg = eggById(eggId)
	if not egg or not eggOpen(egg) or type(egg.pets) ~= "table" or #egg.pets == 0 then
		notify(player, { type = "egg_error", key = "closed" })
		return
	end
	local allowed = mayOpenEggs(player)
	if allowed ~= true then -- false: Roblox's rules for this player; nil: the check failed for now
		notify(player, { type = "egg_error", key = allowed == false and "restricted" or "try_again" })
		return
	end
	local stand = rendered[egg.id]
	if updateLuck() or (stand and stand.egg ~= egg) then
		-- a luck event started or ended, or the egg was edited on Discord, a moment ago and its stand doesn't show
		-- that yet: the player didn't see these chances, nothing is taken
		notify(player, { type = "egg_error", key = "chances_changed" })
		return
	end
	local pet, chance = rollPet(egg)
	if not pet then
		return
	end
	local petReward = { item = { name = tostring(pet.name) } }
	if not Live.OnHatch then
		local can, problems = Core.CanGive(player, petReward)
		if not can then
			warnOnce(
				"hatch|" .. tostring(pet.name),
				"Egg '" .. tostring(egg.name) .. "': can't give the pet '" .. tostring(pet.name) .. "' (" .. tostring(problems)
					.. "). Add Live.OnHatch (see the top of the Live file) or a value named like the pet in the player's data."
			)
			notify(player, { type = "egg_error", key = "unsupported" })
			return
		end
	end
	local paid, reason = Core.Spend(player, egg.currency, egg.price)
	if not paid then
		notify(player, { type = "egg_error", key = reason == "poor" and "poor" or "unsupported",
			currency = filterText(egg.currency, player.UserId) or "?", price = egg.price })
		return
	end
	local given, problem
	if Live.OnHatch then
		local ok, result = pcall(Live.OnHatch, player, { id = egg.id, name = egg.name, currency = egg.currency, price = egg.price }, pet.name)
		given = ok and result ~= false
		problem = ok and "Live.OnHatch returned false" or tostring(result)
	else
		local ok, _, details = Core.GiveReward(player, petReward)
		given = ok
		problem = details
	end
	if not given then
		-- The price goes back; a failed refund is tried again and, if it still fails, written to the log with
		-- everything the owner needs to give it back by hand
		local refunded, refundReason, refundDetails = false, nil, nil
		for attempt = 1, CONFIG.RefundRetries do
			refunded, refundReason, refundDetails = Core.GiveReward(player, { currency = { name = egg.currency, amount = egg.price } }, true)
			if refunded or not player.Parent then
				break
			end
			task.wait(attempt)
		end
		if refunded then
			warn("[DiscordLive] Could not give the pet '" .. tostring(pet.name) .. "' from '" .. tostring(egg.name) .. "', the price was refunded: " .. tostring(problem))
		else
			warn("[DiscordLive] Could not give the pet '" .. tostring(pet.name) .. "' from '" .. tostring(egg.name) .. "' (" .. tostring(problem)
				.. ") and the price could NOT be refunded (" .. tostring(refundReason) .. ": " .. tostring(refundDetails) .. "). Give "
				.. player.Name .. " (" .. player.UserId .. ") " .. tostring(egg.price) .. " " .. tostring(egg.currency) .. " back by hand.")
		end
		notify(player, { type = "egg_error", key = "error" })
		return
	end
	hatchedEvent:Fire(player, egg, pet.name)
	notify(player, { type = "hatch", pet = filterText(pet.name, player.UserId) or "?", chance = chance,
		rare = (tonumber(pet.chance) or 0) <= CONFIG.RareChance,
		egg = filterText(egg.name, player.UserId) or "", egg_id = egg.id })
end

-- ---------- Gifts from /give ----------

local function deliverWaitingGifts(player)
	local ok, pages = pcall(function()
		return giftsStore:ListKeysAsync("gift_" .. player.UserId .. "_", 50)
	end)
	local keys = {}
	if ok then
		-- Every waiting gift, not only the first page of 50
		for _ = 1, CONFIG.MaxGiftPages do
			local pageOk, page = pcall(function()
				return pages:GetCurrentPage()
			end)
			if not pageOk then
				break
			end
			for _, keyInfo in ipairs(page) do
				table.insert(keys, keyInfo.KeyName)
			end
			if pages.IsFinished then
				break
			end
			local nextOk = pcall(function()
				pages:AdvanceToNextPageAsync()
			end)
			if not nextOk then
				break
			end
		end
	elseif not Core.IsStudioError(pages) then
		warn("[DiscordLive] Could not check gifts for " .. player.Name .. ": " .. tostring(pages))
	end

	for _, key in ipairs(keys) do
		if not player.Parent then
			break
		end
		local gift = nil
		local claimOk, claimError = pcall(function()
			giftsStore:UpdateAsync(key, function(old)
				gift = nil
				if type(old) ~= "table" or old.given then
					return nil
				end
				if old.claimed and os.time() - (tonumber(old.claimed) or 0) < CONFIG.StuckClaimSeconds then
					return nil
				end
				old.claimed = os.time()
				gift = old
				return old
			end)
		end)
		if not claimOk then
			warn("[DiscordLive] Could not claim a gift: " .. tostring(claimError))
		elseif gift and type(gift.reward) == "table" then
			local given, reason, details = false, "left", nil
			if player.Parent then
				given, reason, details = Core.GiveReward(player, gift.reward)
			end
			if given then
				local removed = pcall(function()
					giftsStore:RemoveAsync(key)
				end)
				if not removed then
					pcall(function()
						giftsStore:UpdateAsync(key, function(old)
							if type(old) == "table" then
								old.given = os.time()
							end
							return old
						end)
					end)
				end
				notify(player, { type = "gift", reward = filteredReward(gift.reward, player.UserId),
					message = filterText(gift.message, player.UserId) or "" })
				giftReceived:Fire(player, gift.reward, gift.message)
			elseif reason == "unsupported" or reason == "left" then
				-- give it back: it is delivered on a later join, after the game is fixed
				pcall(function()
					giftsStore:UpdateAsync(key, function(old)
						if type(old) == "table" then
							old.claimed = nil
						end
						return old
					end)
				end)
				if reason == "unsupported" then
					warnOnce("gift|" .. tostring(details), "A gift for " .. player.Name .. " can't be given yet: " .. tostring(details) .. ". It keeps waiting and is delivered when the reward fits the game.")
				end
			else
				-- an error halfway through: never repeat it, so it can't be used to get the reward twice
				pcall(function()
					giftsStore:UpdateAsync(key, function(old)
						if type(old) == "table" then
							old.given = os.time()
							old.error = tostring(details)
						end
						return old
					end)
				end)
				warn("[DiscordLive] Error while giving a gift to " .. player.Name .. ": " .. tostring(details) .. ". It was marked as given.")
			end
		end
	end
end

local function deliverGifts(player)
	if not player.Parent then
		return
	end
	if giftBusy[player] then
		-- a gift sent while the earlier ones are being given (two /give a second apart): its key may not have been on
		-- the list read a moment ago, so the list is read again when they are done (gifts have no 60 s poll)
		giftAgain[player] = true
		return
	end
	giftBusy[player] = true
	repeat
		giftAgain[player] = nil
		-- an error must not leave giftBusy set: the player's later gifts would wait until they rejoin
		local ok, err = pcall(deliverWaitingGifts, player)
		if not ok then
			warn("[DiscordLive] Error while giving gifts to " .. player.Name .. ": " .. tostring(err))
		end
	until not giftAgain[player] or not player.Parent
	giftBusy[player] = nil
	giftAgain[player] = nil
end

-- Public versions for your own egg shop UI and your own data loading
function Live.OpenEgg(player, eggId)
	openEgg(player, eggId)
end

function Live.DeliverGifts(player)
	deliverGifts(player)
end

-- A gift from the ⚙️ Manager, saved like a /give from Discord: the player gets it now (on any server) or when they
-- join next time. reward: { currency = { name, amount }, exp = n, item = { name, is_temporary, duration_seconds } }.
-- Returns true and the gift's key, or false and the error.
function Live.SendGift(userId, reward, message, from)
	userId = math.floor(tonumber(userId) or 0)
	local key = "gift_" .. userId .. "_" .. os.time() .. string.format("%04x", random:NextInteger(0, 65535))
	local ok, err = pcall(function()
		giftsStore:SetAsync(key, { reward = reward, message = message or "", from = from or "", created_at = os.time() }, { userId })
	end)
	if not ok then
		return false, tostring(err)
	end
	local target = Players:GetPlayerByUserId(userId)
	if target then
		task.spawn(deliverGifts, target)
	end
	Core.Publish(CONFIG.MessagingTopic, { type = "gift", user_id = userId })
	return true, key
end

-- ---------- Announcements ----------

local function announce(data)
	local text = filterText(firstChars(data.text, 200))
	if not text or text == "" then
		warnOnce("announce-filter", "An announcement could not be shown: the text could not be filtered (no players on this server).")
		return
	end
	local seconds = math.clamp(tonumber(data.seconds) or 10, 3, 60)
	if Live.OnAnnouncement then
		local ok, handled = pcall(Live.OnAnnouncement, text, seconds)
		if ok and handled == true then
			return
		end
	end
	if remote then
		remote:FireAllClients({ type = "announce", text = text, seconds = seconds })
	end
end

-- An announcement from the ⚙️ Manager: on this server at once, on every other one within a second or two.
-- Returns ok and the error when the other servers couldn't be told.
function Live.Announce(text, seconds)
	local data = { type = "announce", text = firstChars(text, 200), seconds = seconds }
	task.spawn(announce, data)
	return Core.Publish(CONFIG.MessagingTopic, { type = "announce", text = data.text, seconds = seconds })
end

-- ---------- For the ⚙️ Manager ----------

-- The names of the egg spots in the game (the "Spot" attribute or the part's name), for the egg form
function Live.GetSpotNames()
	local names = {}
	for _, spot in ipairs(getSpots()) do
		table.insert(names, spotName(spot))
	end
	return names
end

-- ---------- Previews for the ⚙️ Manager ----------

-- Shows ONE player what everyone would see, without giving, spending or saving anything. kind:
-- "announce" (arg.text), "gift" (arg.reward, arg.message), "hatch" (arg.egg = an egg id), "event" (arg.name: an event
-- bar for 30 s with 2x on every currency, next to the real events). Returns false when there is nothing to show.
function Live.Preview(player, kind, arg)
	arg = type(arg) == "table" and arg or {}
	if kind == "announce" then
		local text = filterText(firstChars(arg.text, 200), player.UserId)
		if not text or text == "" then
			return false
		end
		notify(player, { type = "announce", text = text, seconds = 6 })
	elseif kind == "gift" then
		notify(player, { type = "gift", reward = filteredReward(arg.reward, player.UserId),
			message = filterText(firstChars(arg.message, 200), player.UserId) or "" })
	elseif kind == "hatch" then
		local egg = eggById(arg.egg)
		if not egg then
			return false
		end
		local pet, chance = rollPet(egg)
		if not pet then
			return false
		end
		notify(player, { type = "hatch", pet = filterText(pet.name, player.UserId) or "?", chance = chance,
			rare = (tonumber(pet.chance) or 0) <= CONFIG.RareChance, egg = filterText(egg.name, player.UserId) or "",
			egg_id = egg.id })
	elseif kind == "animation" then
		if type(arg.animation) ~= "string" or #arg.animation > 40 then
			return false
		end
		notify(player, { type = "effect_preview", animation = arg.animation })
	elseif kind == "event" then
		local list = {}
		for _, event in ipairs(Live.GetEvents()) do
			table.insert(list, { id = event.id, name = filterText(event.name) or "", starts_at = event.starts_at, ends_at = event.ends_at,
				animation = event.animation, multipliers = filteredMultipliers(event.multipliers) })
		end
		table.insert(list, { name = filterText(firstChars(arg.name, 60), player.UserId) or "", ends_at = os.time() + 30,
			multipliers = { ["currency:*"] = 2 } })
		notify(player, { type = "events", events = list, server_time = os.time() })
	else
		return false
	end
	return true
end

-- ---------- Start ----------

function Live.Start()
	if started then
		return
	end
	started = true

	remote = Core.FindRemote(remoteName, "RemoteEvent")
	-- The player's window asks for the current events when it loads
	remote.OnServerEvent:Connect(function(player, request)
		if request == "hello" and (not lastHello[player] or os.clock() - lastHello[player] > 5) then
			lastHello[player] = os.clock()
			sendEvents(player)
		end
	end)

	local function onPlayer(player)
		task.delay(CONFIG.GiftDelaySeconds, deliverGifts, player)
		if CONFIG.PaidRandomItems then
			task.spawn(checkPaidRandomItems, player) -- ready before the first egg, so opening doesn't wait
		end
		if pendingFilter then
			queueRender()
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		lastOpen[player] = nil
		lastHello[player] = nil
		giftBusy[player] = nil
		giftAgain[player] = nil
		randomItemsAllowed[player] = nil
	end)

	CollectionService:GetInstanceAddedSignal(CONFIG.EggSpotTag):Connect(queueRender)
	CollectionService:GetInstanceRemovedSignal(CONFIG.EggSpotTag):Connect(queueRender)

	Live.EventsChanged:Connect(updateLuck) -- a luck event from Discord: the chances on the eggs change at once
	Core.RefreshUntilFresh(Live.RefreshEvents)
	Core.RefreshUntilFresh(Live.RefreshEggs)

	task.spawn(function()
		while true do
			task.wait(CONFIG.PollIntervalSeconds)
			Core.RefreshUntilFresh(Live.RefreshEvents)
			Core.RefreshUntilFresh(Live.RefreshEggs)
		end
	end)

	-- Egg timers every 10 s, rainbow eggs change color
	task.spawn(function()
		local hue = 0
		local tick = 0
		while true do
			task.wait(0.2)
			hue = (hue + 0.01) % 1
			for _, stand in pairs(rendered) do
				local part = stand.model.PrimaryPart
				if part and part:GetAttribute("Rainbow") then
					part.Color = Color3.fromHSV(hue, 0.6, 1)
				end
			end
			tick = tick + 1
			if tick % 5 == 0 then
				updateLuck() -- a luck event ends by its time, without a notification: the chances follow within a second
			end
			if tick >= 50 then
				tick = 0
				if updateTimers() then
					queueRender()
				end
			end
		end
	end)

	task.spawn(function()
		-- Roblox may refuse for a moment: tried again later (announcements and instant gifts need it; the rest still
		-- refreshes every PollIntervalSeconds)
		for attempt = 1, 8 do
			local ok, err = pcall(function()
				MessagingService:SubscribeAsync(CONFIG.MessagingTopic, function(message)
					local decoded, data = pcall(function()
						return HttpService:JSONDecode(message.Data)
					end)
					if not decoded or type(data) ~= "table" or Core.IsOwnMessage(data) then
						return -- a message this server sent: it already did that itself
					end
					if data.type == "events" then
						task.delay(random:NextNumber() * 2, Core.RefreshUntilFresh, Live.RefreshEvents, data.at)
					elseif data.type == "eggs" then
						task.delay(random:NextNumber() * 2, Core.RefreshUntilFresh, Live.RefreshEggs, data.at)
					elseif data.type == "announce" then
						task.spawn(announce, data)
					elseif data.type == "access" then -- who may open the ⚙️ Manager changed on Discord
						if Live.OnAccess then
							Live.OnAccess()
						end
					elseif data.type == "gift" then
						local target = Players:GetPlayerByUserId(tonumber(data.user_id) or 0)
						if target then
							task.spawn(deliverGifts, target)
						end
					end
				end)
			end)
			if ok then
				return
			end
			if attempt == 1 then
				warn("[DiscordLive] Could not subscribe to notifications, trying again (data still refreshes every "
					.. CONFIG.PollIntervalSeconds .. " s): " .. tostring(err))
			elseif attempt == 8 then
				warn("[DiscordLive] Gave up subscribing to notifications on this server: announcements and instant gifts "
					.. "won't show here until it restarts (events and eggs still refresh every "
					.. CONFIG.PollIntervalSeconds .. " s, gifts on rejoin): " .. tostring(err))
				return
			end
			task.wait(math.min(15 * 2 ^ attempt, 600))
		end
	end)

	print("[DiscordLive] Ready. Events: " .. #Live.GetActiveEvents() .. ", eggs: " .. #activeEggs)
end

return Live
]]></ProtectedString>
			</Properties>
